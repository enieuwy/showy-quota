#compdef showy-quota showy-quota-fetch showy-quota-state

_showy-quota() {
    local mode="${words[2]}" previous="" dashdash
    local -a options themes guard_options
    (( CURRENT > 1 )) && previous="${words[CURRENT-1]}"
    guard_options=(--provider --window --min-remaining --max-used --no-fetch --allow-stale --wait-max --json --quiet -h --help)

    case "${words[1]:t}" in
        showy-quota-fetch)
            options=(--refresh --json --cache-only --age --path --stop-serve --serve-status --restart-serve --record --fixture-dir --sanitize --replay -h --help)
            _describe 'option' options
            return ;;
        showy-quota-state)
            options=(--json --count --providers --explain --no-fetch -h --help)
            _describe 'option' options
            return ;;
    esac

    if [[ "${previous}" == --set || "${previous}" == --preview ]]; then
        # --list reads local theme directories and prints undecorated names.
        themes=("${(@f)$(showy-quota --list 2>/dev/null)}")
        _describe 'theme' themes
        return
    fi
    case "${mode}" in
        config)
            (( CURRENT == 3 )) || return
            options=(get set unset list) ;;
        theme)
            (( CURRENT == 3 )) || return
            options=(list show validate new import-base16 import-iterm) ;;
        tmux)
            options=(sync doctor --socket --dry-run --json) ;;
        preview)
            if [[ "${previous}" == --surface ]]; then
                options=(zellij tmux sketchybar plan rows vertical)
            elif [[ "${previous}" == --fixture ]]; then
                _files
                return
            else
                options=(--surface --fixture --theme)
            fi ;;
        --check-terminal) options=(--json) ;;
        --tmux-doctor) options=(--socket --json) ;;
        guard|run|next-reset|pick)
            if [[ "${mode}" == run ]]; then
                dashdash=${words[(i)--]}
                if (( dashdash < CURRENT )); then
                    # Everything after -- is the gated command.
                    words=("${(@)words[dashdash+1,-1]}")
                    (( CURRENT -= dashdash ))
                    _normal
                    return
                fi
            fi
            case "${previous}" in
                --window)
                    options=(primary secondary tertiary worst)
                    _describe 'window' options
                    return ;;
                --format)
                    options=(id json)
                    _describe 'format' options
                    return ;;
                --provider|--providers|--min-remaining|--max-used|--wait-max)
                    _message 'value'
                    return ;;
            esac
            case "${mode}" in
                guard) options=("${guard_options[@]}") ;;
                run) options=("${guard_options[@]}" --) ;;
                next-reset) options=(--provider --window --json --epoch --seconds --no-fetch -h --help) ;;
                pick) options=(--min-remaining --window --format --no-fetch --providers -h --help) ;;
            esac ;;
        prompt)
            case "${previous}" in
                --provider) _message 'provider ID'; return ;;
                --format) _message 'template, e.g. {sigil} {remaining}%'; return ;;
            esac
            options=(--ansi --provider --format -h --help) ;;
        serve)
            if (( CURRENT == 3 )); then
                options=(status restart stop -h --help)
            elif [[ "${words[3]}" == status ]]; then
                options=(--json)
            else
                return
            fi ;;
        --diagnose|--check-config)
            options=(--json --redact) ;;
        --grant-zellij)
            if [[ "${PREFIX}" != -* ]]; then
                _files
                return
            fi
            options=(--manage-serve --cli-fallback --force --dry-run --check) ;;
        *)
            (( CURRENT == 2 )) || return
            options=(--set --unset --current --list --preview --diagnose --check-config --grant-zellij
                --check-terminal --tmux-doctor --diagnose-zellij config theme tmux preview
                guard prompt serve next-reset run pick refresh -h --help) ;;
    esac
    _describe 'option' options
}

_showy-quota "$@"
