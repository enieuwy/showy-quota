# Generated from share/config-manifest.json. Edit config.env, not this file.
# config.env is trusted shell code. Theme manifests are JSON data.

# Force ANSI color even when the output is not a terminal.
# SHOWY_QUOTA_FORCE_COLOR=0

# Recreate the items during the next SketchyBar update.
# SHOWY_QUOTA_SKETCHYBAR_FORCE_REDECLARE=0

# Override the file used for provider font icons.
# SHOWY_QUOTA_SKETCHYBAR_ICON_FONT_FILE=''

# Set the corner radius of a native slider row.
# SHOWY_QUOTA_SKETCHYBAR_ROW_RADIUS=3

# Mark supplied data as degraded CLI fallback data.
# SHOWY_QUOTA_DEGRADED_CLI=0

# Hide bar lanes and labels above the compact provider threshold.
# SHOWY_QUOTA_SKETCHYBAR_AUTO_COMPACT=off

# Maximum accepted provider payload size in bytes.
# SHOWY_QUOTA_MAX_USAGE_JSON_BYTES=5242880

# Refresh seconds.
# SHOWY_QUOTA_REFRESH_SECONDS=120

# Lock wait tenths.
# SHOWY_QUOTA_LOCK_WAIT_TENTHS=100

# Cache dir.
# SHOWY_QUOTA_CACHE_DIR='${XDG_CACHE_HOME:-${HOME}/.cache}/showy-quota'

# Codexbar bin.
# SHOWY_QUOTA_CODEXBAR_BIN=codexbar

# Codexbar serve url.
# SHOWY_QUOTA_CODEXBAR_SERVE_URL=http://127.0.0.1:8080

# Codexbar serve refresh interval seconds.
# SHOWY_QUOTA_CODEXBAR_SERVE_REFRESH_INTERVAL_SECONDS=''

# Codexbar serve start wait tenths.
# SHOWY_QUOTA_CODEXBAR_SERVE_START_WAIT_TENTHS=30

# Manage serve.
# SHOWY_QUOTA_MANAGE_SERVE=1

# Codexbar serve timeout seconds.
# SHOWY_QUOTA_CODEXBAR_SERVE_TIMEOUT_SECONDS=10

# Codexbar serve usage timeout seconds.
# SHOWY_QUOTA_CODEXBAR_SERVE_USAGE_TIMEOUT_SECONDS=30

# Codexbar serve refresh seconds.
# SHOWY_QUOTA_CODEXBAR_SERVE_REFRESH_SECONDS=''

# Codexbar cli timeout seconds.
# SHOWY_QUOTA_CODEXBAR_CLI_TIMEOUT_SECONDS=20

# Codexbar serve failures before restart.
# SHOWY_QUOTA_CODEXBAR_SERVE_FAILURES_BEFORE_RESTART=3

# Codexbar serve failures before cli.
# SHOWY_QUOTA_CODEXBAR_SERVE_FAILURES_BEFORE_CLI='${SHOWY_QUOTA_CODEXBAR_SERVE_FAILURES_BEFORE_RESTART}'

# Codexbar serve failure backoff seconds.
# SHOWY_QUOTA_CODEXBAR_SERVE_FAILURE_BACKOFF_SECONDS=60

# Codexbar cli failure backoff seconds.
# SHOWY_QUOTA_CODEXBAR_CLI_FAILURE_BACKOFF_SECONDS='${SHOWY_QUOTA_REFRESH_SECONDS}'

# Codexbar config providers timeout seconds.
# SHOWY_QUOTA_CODEXBAR_CONFIG_PROVIDERS_TIMEOUT_SECONDS=5

# Codexbar config providers backoff seconds.
# SHOWY_QUOTA_CODEXBAR_CONFIG_PROVIDERS_BACKOFF_SECONDS=60

# Provider failure backoff seconds.
# SHOWY_QUOTA_PROVIDER_FAILURE_BACKOFF_SECONDS='${SHOWY_QUOTA_REFRESH_SECONDS}'

# Providers.
# SHOWY_QUOTA_PROVIDERS=''

# Providers exclude.
# SHOWY_QUOTA_PROVIDERS_EXCLUDE=''

# Provider order.
# SHOWY_QUOTA_PROVIDER_ORDER='${SHOWY_QUOTA_PROVIDER_DEFAULT_ORDER}'

# Include status.
# SHOWY_QUOTA_INCLUDE_STATUS=1

# Palette primary good.
# SHOWY_QUOTA_PALETTE_PRIMARY_GOOD=25be6a

# Palette primary warn.
# SHOWY_QUOTA_PALETTE_PRIMARY_WARN=f0af00

# Palette primary bad.
# SHOWY_QUOTA_PALETTE_PRIMARY_BAD=ee5396

# Palette primary unknown.
# SHOWY_QUOTA_PALETTE_PRIMARY_UNKNOWN=6c7086

# Palette dim scale.
# SHOWY_QUOTA_PALETTE_DIM_SCALE=0.55

# Dim window minutes.
# SHOWY_QUOTA_DIM_WINDOW_MINUTES=10080

# Palette bg.
# SHOWY_QUOTA_PALETTE_BG=161616

# Palette surface.
# SHOWY_QUOTA_PALETTE_SURFACE=2a2a2a

# Palette track.
# SHOWY_QUOTA_PALETTE_TRACK=3a3a4a

# Palette icon text.
# SHOWY_QUOTA_PALETTE_ICON_TEXT=f2f4f8

# Palette countdown.
# SHOWY_QUOTA_PALETTE_COUNTDOWN=7b8496

# Palette countdown warn.
# SHOWY_QUOTA_PALETTE_COUNTDOWN_WARN='${SHOWY_QUOTA_PALETTE_PRIMARY_BAD}'

# Palette stale.
# SHOWY_QUOTA_PALETTE_STALE='${SHOWY_QUOTA_PALETTE_PRIMARY_UNKNOWN}'

# Palette elapsed.
# SHOWY_QUOTA_PALETTE_ELAPSED=be95ff

# Palette elapsed long.
# SHOWY_QUOTA_PALETTE_ELAPSED_LONG=3ddbd9

# Stale glyph.
# SHOWY_QUOTA_STALE_GLYPH='⚠'

# Degraded cli glyph.
# SHOWY_QUOTA_DEGRADED_CLI_GLYPH='⚠cli'

# Good min remaining.
# SHOWY_QUOTA_GOOD_MIN_REMAINING=40

# Warn min remaining.
# SHOWY_QUOTA_WARN_MIN_REMAINING=15

# Time warn minutes.
# SHOWY_QUOTA_TIME_WARN_MINUTES=30

# Codexbar resources.
# SHOWY_QUOTA_CODEXBAR_RESOURCES=/Applications/CodexBar.app/Contents/Resources

# Sketchybar image cache.
# SHOWY_QUOTA_SKETCHYBAR_IMAGE_CACHE='${SHOWY_QUOTA_CACHE_DIR}/sketchybar'

# Sketchybar click.
# SHOWY_QUOTA_SKETCHYBAR_CLICK='open -b com.steipete.codexbar'

# Sketchybar update freq.
# SHOWY_QUOTA_SKETCHYBAR_UPDATE_FREQ=10

# Png bar w.
# SHOWY_QUOTA_PNG_BAR_W=80

# Png bar h.
# SHOWY_QUOTA_PNG_BAR_H=18

# Sketchybar icon width.
# SHOWY_QUOTA_SKETCHYBAR_ICON_WIDTH=22

# Sketchybar icon padding left.
# SHOWY_QUOTA_SKETCHYBAR_ICON_PADDING_LEFT=5

# Sketchybar icon scale.
# SHOWY_QUOTA_SKETCHYBAR_ICON_SCALE=0.28

# Sketchybar provider icon mode.
# SHOWY_QUOTA_SKETCHYBAR_PROVIDER_ICON_MODE=svg

# Sketchybar provider icon font.
# SHOWY_QUOTA_SKETCHYBAR_PROVIDER_ICON_FONT=sketchybar-app-font:Regular:14.0

# Sketchybar provider icon font padding right.
# SHOWY_QUOTA_SKETCHYBAR_PROVIDER_ICON_FONT_PADDING_RIGHT=2

# Sketchybar bar width.
# SHOWY_QUOTA_SKETCHYBAR_BAR_WIDTH='$((SHOWY_QUOTA_PNG_BAR_W + 3))'

# Sketchybar label width.
# SHOWY_QUOTA_SKETCHYBAR_LABEL_WIDTH=32

# Sketchybar placement.
# SHOWY_QUOTA_SKETCHYBAR_PLACEMENT=left

# Sketchybar body.
# SHOWY_QUOTA_SKETCHYBAR_BODY=rows

# Sketchybar popup.
# SHOWY_QUOTA_SKETCHYBAR_POPUP=click

# Sketchybar notch margin.
# SHOWY_QUOTA_SKETCHYBAR_NOTCH_MARGIN=4

# Sketchybar compact provider count.
# SHOWY_QUOTA_SKETCHYBAR_COMPACT_PROVIDER_COUNT=5

# Sketchybar pill radius.
# SHOWY_QUOTA_SKETCHYBAR_PILL_RADIUS=14

# Sketchybar pill height.
# SHOWY_QUOTA_SKETCHYBAR_PILL_HEIGHT=28

# Sketchybar pill color.
# SHOWY_QUOTA_SKETCHYBAR_PILL_COLOR=0xcc24273a

# Zellij widget.
# SHOWY_QUOTA_ZELLIJ_WIDGET=pipe_showy_quota

# Zellij pipe name.
# SHOWY_QUOTA_ZELLIJ_PIPE_NAME=showy-quota

# Zellij pipe interval.
# SHOWY_QUOTA_ZELLIJ_PIPE_INTERVAL=10

# Zellij pipe timeout tenths.
# SHOWY_QUOTA_ZELLIJ_PIPE_TIMEOUT_TENTHS=20

# Zellij bar width.
# SHOWY_QUOTA_ZELLIJ_BAR_WIDTH=12

# Terminal bar mode.
# SHOWY_QUOTA_TERMINAL_BAR_MODE=auto

# Provider modes.
# SHOWY_QUOTA_PROVIDER_MODES=gemini=mono3,cursor=mono3

# Mono color mode.
# SHOWY_QUOTA_MONO_COLOR_MODE=lowest

# Mono markers.
# SHOWY_QUOTA_MONO_MARKERS=primary

# Provider thresholds.
# SHOWY_QUOTA_PROVIDER_THRESHOLDS=''

# Window thresholds.
# SHOWY_QUOTA_WINDOW_THRESHOLDS=''

# Windows.
# SHOWY_QUOTA_WINDOWS=primary,secondary,tertiary

# Window mode.
# SHOWY_QUOTA_WINDOW_MODE=all

# Compact provider count.
# SHOWY_QUOTA_COMPACT_PROVIDER_COUNT=0

# Width budget.
# SHOWY_QUOTA_WIDTH_BUDGET=0

# Compact order.
# SHOWY_QUOTA_COMPACT_ORDER=ordered

# Zellij bin.
# SHOWY_QUOTA_ZELLIJ_BIN=zellij

# Zellij plugin.
# SHOWY_QUOTA_ZELLIJ_PLUGIN=''

# Usage file.
# SHOWY_QUOTA_USAGE_FILE='${SHOWY_QUOTA_CACHE_DIR}/usage.json'

# Usage stamp.
# SHOWY_QUOTA_USAGE_STAMP='${SHOWY_QUOTA_CACHE_DIR}/usage.json.updated-at'

# Codexbar serve pid file.
# SHOWY_QUOTA_CODEXBAR_SERVE_PID_FILE='${SHOWY_QUOTA_CACHE_DIR}/codexbar-serve.pid'

# Usage lock.
# SHOWY_QUOTA_USAGE_LOCK='${SHOWY_QUOTA_CACHE_DIR}/usage.lock'

# Codexbar serve failure stamp.
# SHOWY_QUOTA_CODEXBAR_SERVE_FAILURE_STAMP='${SHOWY_QUOTA_CACHE_DIR}/serve-failed-at'

# Codexbar serve failure count file.
# SHOWY_QUOTA_CODEXBAR_SERVE_FAILURE_COUNT_FILE='${SHOWY_QUOTA_CACHE_DIR}/serve-failed-count'

# Codexbar cli failure stamp.
# SHOWY_QUOTA_CODEXBAR_CLI_FAILURE_STAMP='${SHOWY_QUOTA_CACHE_DIR}/cli-failed-at'

# Codexbar config providers failure stamp.
# SHOWY_QUOTA_CODEXBAR_CONFIG_PROVIDERS_FAILURE_STAMP='${SHOWY_QUOTA_CACHE_DIR}/config-providers-failed-at'

# Provider failure dir.
# SHOWY_QUOTA_PROVIDER_FAILURE_DIR='${SHOWY_QUOTA_CACHE_DIR}/provider-failures'

# Freshness.
# SHOWY_QUOTA_FRESHNESS=off

# Severity glyphs.
# SHOWY_QUOTA_SEVERITY_GLYPHS=False

# Palette dim good.
# SHOWY_QUOTA_PALETTE_DIM_GOOD=''

# Palette dim warn.
# SHOWY_QUOTA_PALETTE_DIM_WARN=''

# Palette dim bad.
# SHOWY_QUOTA_PALETTE_DIM_BAD=''

# Palette dim unknown.
# SHOWY_QUOTA_PALETTE_DIM_UNKNOWN=''

# Error glyph.
# SHOWY_QUOTA_ERROR_GLYPH='⚠'

# Reset description timezone offset minutes.
# SHOWY_QUOTA_RESET_DESCRIPTION_TIMEZONE_OFFSET=''

# Theme.
# SHOWY_QUOTA_THEME=default

# Tmux bar width.
# SHOWY_QUOTA_TMUX_BAR_WIDTH=''

# Vertical bar width.
# SHOWY_QUOTA_VERTICAL_BAR_WIDTH=16

# Vertical sort.
# SHOWY_QUOTA_VERTICAL_SORT=provider

# Vertical reset clock.
# SHOWY_QUOTA_VERTICAL_RESET_CLOCK=True

# Cap left.
# SHOWY_QUOTA_CAP_LEFT=''

# Cap right.
# SHOWY_QUOTA_CAP_RIGHT=''

# Render bin.
# SHOWY_QUOTA_RENDER_BIN=''

# Fetch bin.
# SHOWY_QUOTA_FETCH_BIN=''

# Fixture.
# SHOWY_QUOTA_FIXTURE=''

# Zellij permissions file.
# SHOWY_QUOTA_ZELLIJ_PERMISSIONS_FILE=''

# No config.
# SHOWY_QUOTA_NO_CONFIG=''

# Override the clock for deterministic fixture rendering.
# SHOWY_QUOTA_NOW_EPOCH=''

