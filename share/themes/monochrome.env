# High-contrast grayscale palette with ASCII severity cues.
: "${SHOWY_QUOTA_PALETTE_PRIMARY_GOOD:=ffffff}"
: "${SHOWY_QUOTA_PALETTE_PRIMARY_WARN:=c6c6c6}"
: "${SHOWY_QUOTA_PALETTE_PRIMARY_BAD:=8d8d8d}"
: "${SHOWY_QUOTA_PALETTE_PRIMARY_UNKNOWN:=a8a8a8}"
: "${SHOWY_QUOTA_PALETTE_DIM_SCALE:=0.7}"
: "${SHOWY_QUOTA_PALETTE_BG:=000000}"
: "${SHOWY_QUOTA_PALETTE_SURFACE:=262626}"
: "${SHOWY_QUOTA_PALETTE_TRACK:=393939}"
: "${SHOWY_QUOTA_PALETTE_ICON_TEXT:=ffffff}"
: "${SHOWY_QUOTA_PALETTE_COUNTDOWN:=e0e0e0}"
: "${SHOWY_QUOTA_PALETTE_COUNTDOWN_WARN:=ffffff}"
: "${SHOWY_QUOTA_PALETTE_STALE:=a8a8a8}"
: "${SHOWY_QUOTA_PALETTE_ELAPSED:=ffffff}"
: "${SHOWY_QUOTA_PALETTE_ELAPSED_LONG:=bdbdbd}"
: "${SHOWY_QUOTA_SEVERITY_GLYPHS:=on}"
