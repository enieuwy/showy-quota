#!/usr/bin/env bash
# showy-quota — stable state surface for layout managers and adapters.
#
# Reads the shared CodexBar cache through showy-quota-fetch, applies the same
# renderable-provider filtering as every bar renderer, and emits compact JSON
# that external coordinators can consume without knowing CodexBar's schema.
#
# Flags:
#   --json       Default. Print the full state JSON.
#   --count      Print only the filtered provider count.
#   --providers  Print filtered provider ids, one per line.
#   --explain    Explain every cached provider; add --json for JSON output.
#   --no-fetch   Report the cache as-is; skip the internal refresh (cache-only).

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_PATH}" ]]; do
    link=$(readlink "${SCRIPT_PATH}")
    if [[ "${link}" == /* ]]; then
        SCRIPT_PATH="${link}"
    else
        SCRIPT_PATH="$(cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd -P)/${link}"
    fi
done
SCRIPT_DIR="$(cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd -P)"
# shellcheck disable=SC1091
. "${SCRIPT_DIR}/../lib/common.sh"
# shellcheck disable=SC1091
. "${SCRIPT_DIR}/../lib/strip.sh"

mode="json"
explain_json=0
no_fetch=0
while (($#)); do
    case "$1" in
        --json)      explain_json=1; if [[ "${mode}" != "explain" ]]; then mode="json"; fi ;;
        --count)     mode="count" ;;
        --providers) mode="providers" ;;
        --explain)   mode="explain" ;;
        --no-fetch)  no_fetch=1 ;;
        -h|--help)
            printf '%s\n' \
                'Usage: showy-quota-state [--json|--count|--providers|--explain [--json]] [--no-fetch]' \
                '' \
                'Emits filtered CodexBar provider state for external layout managers.' \
                '' \
                '  --explain   Explain each cached provider and its order (text by default).' \
                '  --no-fetch  Report the cache as-is; skip the internal refresh (cache-only).'
            exit 0
            ;;
        *) showy_quota_die "unknown argument: $1" ;;
    esac
    shift
done

showy_quota_have jq || showy_quota_die "jq is required"

FETCH="${SHOWY_QUOTA_FETCH_BIN:-${SCRIPT_DIR}/showy-quota-fetch}"
FETCH="$(showy_quota_valid_bin "${FETCH}")" || FETCH="${SCRIPT_DIR}/showy-quota-fetch"
threshold="${SHOWY_QUOTA_SKETCHYBAR_COMPACT_PROVIDER_COUNT:-5}"
if [[ ! "${threshold}" =~ ^[0-9]+$ ]]; then
    threshold=5
fi

# Provider errors are included in state JSON and bug-report diagnostics. Keep
# the classification from the native renderer, but remove credential and local
# identity material before the message crosses this public-facing boundary.
sanitize_error_message() {
    jq -c --arg home "${HOME}" '
        def sanitize_error_message:
            gsub("(?i)\\b(?:Cookie|Authorization)[[:space:]]*:[^\r\n]*"; "<redacted-header>")
            | gsub("[[:cntrl:]]"; "")
            | gsub("[[:space:]]+"; " ")
            | split($home) | join("<redacted-home>")
            | gsub("[[:alnum:]._%+-]+@[[:alnum:].-]+\\.[[:alpha:]]{2,}"; "<redacted-email>")
            | gsub("(?i)\\b(?:bearer|token)[[:space:]]*(?:=|:)?[[:space:]]*[A-Za-z0-9+/_-]{20,}={0,2}"; "<redacted-secret>")
            | gsub("(?i)\\b[0-9a-f]{20,}\\b"; "<redacted-secret>")
            | gsub("[A-Za-z0-9+/_-]{20,}={0,2}"; "<redacted-secret>")
            | .[0:160];
        map(
            if (.error? != null and (.error.message | type) == "string") then
                .error.message |= sanitize_error_message
            else
                .
            end
        )'
}

# Classify an empty render surface, mirroring the strip's own label
# (`crates/showy-quota-zellij-core/src/render.rs::empty_reason`): an empty
# CodexBar inventory, a user filter that removed everything, and quota that
# is simply unused need three different responses, and one shared `idle`
# reported the most common first-run failure as healthy.
# Prints the reason token, or nothing when the surface is not empty.
empty_reason_for() {
    local rendered="$1" payload="$2"
    if (( rendered > 0 )); then
        return 0
    fi
    printf '%s' "${payload}" | jq -r \
        --arg allow "${SHOWY_QUOTA_PROVIDERS:-}" \
        --arg exclude "${SHOWY_QUOTA_PROVIDERS_EXCLUDE:-}" '
        def valid_provider_id:
            type == "string"
            and (length <= 64)
            and test("^[A-Za-z0-9_.-]+$")
            and . != "."
            and . != ".."
            and (startswith("-") | not);
        def renderable:
            (.error // null) == null
            and (.provider | valid_provider_id)
            and ([.usage.primary, .usage.secondary, .usage.tertiary]
                 | any(. != null and (.usedPercent | type == "number")));
        def errored:
            (.error // null) != null and (.provider | valid_provider_id) and (renderable | not);
        (if type == "array" then . else [] end) as $records
        | ($records | length) as $total
        | ([ $records[] | select(renderable or errored) ] | length) as $candidates
        | (($allow | length) > 0 or ($exclude | length) > 0) as $filtering
        | if $total == 0 then "no-providers"
          elif $candidates > 0 and $filtering then "filtered"
          else "idle"
          end' 2>/dev/null || printf 'idle'
}

# Per-provider freshness from the cache envelope's `providerMeta`. The cache
# file's own mtime dates the publish, not each record: a provider whose fetch
# failed is republished with its previous slice, and only this map says so.
# A legacy envelope has no map, so every provider inherits the file's age.
provider_freshness_json() {
    local metrics="$1" now meta_file
    now=$(showy_quota_now_epoch)
    # The envelope map travels through a temp file, not argv: a valid cache
    # nears the 5 MiB cap, past the macOS 1 MiB exec argument limit.
    meta_file=$(mktemp "${TMPDIR:-/tmp}/showy-quota-meta.XXXXXX") || return 1
    if [[ -r "${SHOWY_QUOTA_USAGE_FILE}" ]]; then
        jq -c 'if type == "object" and (.providerMeta | type) == "object"
               then .providerMeta else {} end' \
            "${SHOWY_QUOTA_USAGE_FILE}" > "${meta_file}" 2>/dev/null || printf '{}' > "${meta_file}"
    else
        printf '{}' > "${meta_file}"
    fi
    printf '%s' "${metrics}" | jq -c \
        --slurpfile meta "${meta_file}" \
        --argjson now "${now}" \
        --arg cache_age "${cache_age}" \
        --argjson stale_after "${stale_after}" \
        --arg cache_source "${cache_source}" '
        # A present entry with a missing or invalid source stays `unknown`
        # (the native reader contract); only an absent entry inherits the
        # envelope source. Non-object entries count as absent.
        ($meta[0] // {}) as $metamap
        | ($cache_age | if . == "null" then null else tonumber end) as $file_age
        | reduce (.[]? | .provider) as $p ({};
            ($metamap[$p]) as $raw
            | (if ($raw | type) == "object" then $raw else null end) as $entry
            | (if $entry == null then null
               elif ($entry.updatedAt | type) == "number"
                    and $entry.updatedAt >= 0 and ($entry.updatedAt | floor) == $entry.updatedAt
               then $entry.updatedAt | floor else null end) as $updated
            | (if $updated == null then $file_age else (($now - $updated) | fabs | floor) end) as $age
            | .[$p] = {
                source: (if $entry == null then $cache_source
                         elif ($entry.source | IN("serve", "cli")) then $entry.source
                         else "unknown" end),
                updatedAt: $updated,
                ageSeconds: $age,
                stale: ($age != null and $age > $stale_after)
            })' 2>/dev/null || printf '{}'
    rm -f -- "${meta_file}"
}

data=""
available=false
if (( no_fetch )); then
    if data=$("${FETCH}" --cache-only 2>/dev/null) && [[ -n "${data}" ]]; then
        available=true
    fi
elif data=$("${FETCH}" 2>/dev/null) && [[ -n "${data}" ]]; then
    available=true
fi

if [[ "${mode}" == "explain" ]]; then
    if [[ "${available}" == true ]]; then
        decisions=$(printf '%s' "${data}" | showy_quota_explain_providers)
    else
        decisions='[]'
    fi
    if (( explain_json )); then
        printf '%s\n' "${decisions}" | jq -c '.'
    else
        printf '%s\n' "${decisions}" | jq -r '
            .[] | [(.provider | tojson), .reason,
                  (if .position == null then "-" else (.position | tostring) end),
                  .rankSource,
                  (if .orderRank == null then "-" else (.orderRank | tostring) end)]
            | @tsv'
    fi
    exit 0
fi

if [[ "${available}" == true ]]; then
    filtered_json=$(printf '%s' "${data}" | showy_quota_filter_renderable | jq -c '.')
    provider_ids_json=$(printf '%s' "${filtered_json}" | jq -c '[ .[].provider ]')
    showy_quota_export_config
    if render_bin=$(showy_quota_resolve_render_bin "${SCRIPT_DIR}" "${SCRIPT_DIR}/.."); then
        provider_metrics_json=$(printf '%s' "${data}" | "${render_bin}" --emit metrics --json - 2>/dev/null) || provider_metrics_json='[]'
        [[ -n "${provider_metrics_json}" ]] || provider_metrics_json='[]'
    else
        provider_metrics_json='[]'
    fi
else
    filtered_json='[]'
    provider_ids_json='[]'
    provider_metrics_json='[]'
fi
provider_metrics_json="$(printf '%s' "${provider_metrics_json}" | sanitize_error_message)"

cache_age="null"
if [[ -f "${SHOWY_QUOTA_USAGE_FILE}" ]]; then
    cache_age=$(showy_quota_age_seconds "${SHOWY_QUOTA_USAGE_FILE}")
fi
cache_source="$(showy_quota_cache_source)"
# The envelope source is only the starting point: a `cli` publish whose
# slices were all filtered out shows no CLI-sourced row, so the marker must
# derive from the rendered slices below. An explicit env value still wins.
if [[ "${SHOWY_QUOTA_DEGRADED_CLI:-}" == "1" ]]; then
    degraded_flag=true
elif [[ -n "${SHOWY_QUOTA_DEGRADED_CLI:-}" ]]; then
    degraded_flag=false
else
    degraded_flag=false
fi
degraded_envelope_cli=false
if [[ "${cache_source}" == "cli" ]]; then
    degraded_envelope_cli=true
fi
stale_after=$(showy_quota_stale_after_seconds)
if [[ "${cache_age}" != "null" ]] && (( cache_age > stale_after )); then
    stale_flag=true
else
    stale_flag=false
fi

# The whole-cache degraded flag understates a mixed snapshot: a serve publish
# that carried one provider forward from an earlier CLI fallback still has a
# CLI-sourced slice. Derive it from the slices when the envelope describes
# them, exactly like the Rust cache reader does.
provider_freshness_json="$(provider_freshness_json "${provider_metrics_json}")"
if [[ -z "${SHOWY_QUOTA_DEGRADED_CLI:-}" ]]; then
    if [[ "${degraded_envelope_cli}" == true ]] \
        && printf '%s' "${provider_metrics_json}" | jq -e 'length > 0' >/dev/null 2>&1; then
        # A whole-cache CLI source with at least one rendered row: every
        # visible slice came from that CLI publish.
        degraded_flag=true
    elif printf '%s' "${provider_freshness_json}" | jq -e 'any(.[]; .source == "cli")' >/dev/null 2>&1; then
        # A mixed serve publish with a CLI-sourced slice still on screen.
        degraded_flag=true
    fi
fi

rendered_count=$(printf '%s' "${provider_metrics_json}" | jq 'length' 2>/dev/null) || rendered_count=0
if [[ "${available}" == true ]]; then
    empty_reason_token=$(empty_reason_for "${rendered_count}" "${data}")
else
    empty_reason_token="unavailable"
fi
if [[ -z "${empty_reason_token}" ]]; then
    empty_reason='null'
else
    empty_reason=$(jq -n --arg reason "${empty_reason_token}" '$reason')
fi

case "${mode}" in
    count)
        printf '%s\n' "${provider_ids_json}" | jq 'length'
        ;;
    providers)
        printf '%s\n' "${provider_ids_json}" | jq -r '.[]'
        ;;
    json)
        jq -n \
            --argjson providers "${provider_ids_json}" \
            --argjson providerMetrics "${provider_metrics_json}" \
            --argjson available "${available}" \
            --argjson stale "${stale_flag}" \
            --argjson degraded "${degraded_flag}" \
            --arg cache_age "${cache_age}" \
            --arg stale_after "${stale_after}" \
            --arg cache_source "${cache_source}" \
            --argjson providerFreshness "${provider_freshness_json}" \
            --argjson emptyReason "${empty_reason}" \
            --arg compact_threshold "${threshold}" \
            '($compact_threshold | tonumber) as $compact_threshold_num
            | {
                schemaVersion: 1,
                available: $available,
                stale: $stale,
                cache: {
                    source: $cache_source,
                    degraded: $degraded
                },
                cacheAgeSeconds: (if $cache_age == "null" then null else ($cache_age | tonumber) end),
                staleAfterSeconds: ($stale_after | tonumber),
                providers: $providers,
                providerMetrics: $providerMetrics,
                providerCount: ($providers | length),
                providerFreshness: $providerFreshness,
                emptyReason: $emptyReason,
                sketchybar: {
                    itemPrefix: "showy_quota",
                    bracket: "showy_quota_bracket",
                    compactProviderThreshold: $compact_threshold_num,
                    compactRecommended: (($providers | length) >= $compact_threshold_num)
                }
            }'
        ;;
esac
