#!/usr/bin/env bash
# showy-quota — browse, preview, and persist palette themes.

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf 'showy-quota: bash 4+ required (running %s). On macOS, install Homebrew bash and ensure it precedes /bin/bash on PATH.\n' "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_PATH}" ]]; do
    link=$(readlink "${SCRIPT_PATH}")
    if [[ "${link}" == /* ]]; then
        SCRIPT_PATH="${link}"
    else
        SCRIPT_PATH="$(cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd -P)/${link}"
    fi
done
SCRIPT_DIR="$(cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd -P)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/showy-quota"
CONFIG_FILE="${CONFIG_DIR}/config.env"
RENDERER="${SCRIPT_DIR}/showy-quota-zellij-bar"
THEME_NAME_RE='^[A-Za-z0-9._-]+$'

usage() {
    printf '%s\n' \
        'Usage: showy-quota [--set <name>|--unset|--current|--list|--preview <name>|--diagnose [--json] [--redact]|--check-config [--json] [--redact]|--grant-zellij [--dry-run|--check] [opts] [path]]' \
        '       showy-quota guard|prompt|next-reset|run|pick|serve|refresh [opts]   (run each with -h for details)' \
        '' \
        'With no flags, opens an interactive theme selector when fzf and a TTY are available.' \
        'Without fzf or a TTY, prints a deterministic theme list and exact set/unset commands.' \
        '' \
        'Flags:' \
        '  --set <name>      Persist SHOWY_QUOTA_THEME=<name> in config.env' \
        '  --unset           Remove the active SHOWY_QUOTA_THEME= line from config.env' \
        '  --current         Print the persisted theme name, or (none)' \
        '  --list            Print available theme names, one per line' \
        '  --preview <name>  Print one ANSI preview strip for a theme' \
        '  --diagnose        Print runtime state useful for bug reports (--json for machines, --redact for paste-safe output)' \
        '  --check-config    Show ignored or clamped config values and unknown keys (--json, --redact); exit 1 if any' \
        '  --grant-zellij [opts] [p] Pre-grant or inspect Zellij permissions; opts: --dry-run, --check, --manage-serve, --cli-fallback, --force' \
        '  guard [opts]      Evaluate quota thresholds for automation (exit 0/1/2/3); "guard -h" for options' \
        '  prompt [opts]     Print a one-line quota segment for shell prompts; "prompt -h" for options' \
        '  serve <action>    Inspect or control the managed CodexBar serve; "serve -h" for options' \
        '  next-reset [opts] Print time until the selected quota reset; "next-reset -h" for options' \
        '  run [opts] -- CMD Run a command only when its guard passes; "run -h" for options' \
        '  pick [opts]       Choose the provider with most quota; "pick -h" for options' \
        '  refresh           Force cache refresh and nudge present bars' \
        '  -h, --help        Show this help'
}

usage_error() {
    printf 'showy-quota: %s\n\n' "$1" >&2
    usage >&2
    exit 2
}

die() {
    printf 'showy-quota: %s\n' "$1" >&2
    exit 1
}

TEMP_FILES=()

cleanup_temp_files() {
    local file
    for file in "${TEMP_FILES[@]}"; do
        [[ -n "${file}" ]] && rm -f -- "${file}"
    done
}

trap cleanup_temp_files EXIT
trap 'cleanup_temp_files; exit 130' INT
trap 'cleanup_temp_files; exit 143' TERM

track_temp_file() {
    TEMP_FILES+=("$1")
}

# Serialize read-modify-write updates to one file. A dead owner is safe to
# recover because its PID-specific marker cannot belong to a later lock holder.
recover_dead_file_write_lock() {
    local lock_dir="$1" owner_file owner_pid
    local now mtime

    for owner_file in "${lock_dir}"/owner.*; do
        [[ -f "${owner_file}" ]] || continue
        owner_pid="${owner_file##*.}"
        [[ "${owner_pid}" =~ ^[0-9]+$ ]] || return 1
        kill -0 "${owner_pid}" 2>/dev/null && return 1
        rm -f -- "${owner_file}"
        rmdir -- "${lock_dir}" 2>/dev/null
        return $?
    done

    # A holder that died between mkdir and recording its owner marker leaves
    # an ownerless lock dir that would otherwise block every future writer.
    # Reclaim it once it is old enough that a live holder would have written
    # its marker long ago.
    now=$(date +%s)
    if mtime=$(stat -f %m "${lock_dir}" 2>/dev/null) \
        || mtime=$(stat -c %Y "${lock_dir}" 2>/dev/null); then
        if (( now - mtime > 30 || mtime - now > 30 )); then
            rmdir -- "${lock_dir}" 2>/dev/null
            return $?
        fi
    fi

    return 1
}

release_file_write_lock() {
    local lock_dir="$1" owner_file="$2"

    [[ -f "${owner_file}" ]] || return 0
    rm -f -- "${owner_file}"
    rmdir -- "${lock_dir}" 2>/dev/null || true
}

with_file_write_lock() {
    local target="$1"
    shift
    local lock_dir="${target}.lock"
    local max_wait_tenths=50
    local waited=0

    (
        local owner_pid="${BASHPID:-$$}"
        local owner_file="${lock_dir}/owner.${owner_pid}"
        trap 'release_file_write_lock "${lock_dir}" "${owner_file}"; cleanup_temp_files' EXIT

        while ! mkdir -- "${lock_dir}" 2>/dev/null; do
            if recover_dead_file_write_lock "${lock_dir}"; then
                continue
            fi
            if (( waited >= max_wait_tenths )); then
                printf 'showy-quota: timed out waiting for write lock on %s\n' "${target}" >&2
                exit 1
            fi
            sleep 0.1
            (( waited += 1 ))
        done

        if ! printf '%s\n' "${owner_pid}" > "${owner_file}"; then
            rmdir -- "${lock_dir}" 2>/dev/null || true
            printf 'showy-quota: cannot record write-lock owner for %s\n' "${target}" >&2
            exit 1
        fi

        "$@"
    )
}


list_theme_names() {
    local dir path name
    local -a names=()
    declare -A seen=()

    for dir in "${CONFIG_DIR}/themes" "${REPO_ROOT}/share/themes"; do
        [[ -d "${dir}" ]] || continue
        for path in "${dir}"/*.env; do
            [[ -e "${path}" ]] || continue
            name="${path##*/}"
            name="${name%.env}"
            if [[ -z "${seen["${name}"]+x}" ]]; then
                seen["${name}"]=1
                names+=("${name}")
            fi
        done
    done

    ((${#names[@]} > 0)) || return 0
    printf '%s\n' "${names[@]}" | LC_ALL=C sort
}

find_theme_path() {
    local name="$1" path
    [[ "${name}" =~ ${THEME_NAME_RE} ]] || return 1
    for path in \
        "${CONFIG_DIR}/themes/${name}.env" \
        "${REPO_ROOT}/share/themes/${name}.env"
    do
        if [[ -r "${path}" ]]; then
            printf '%s\n' "${path}"
            return 0
        fi
    done
    return 1
}

print_available_themes() {
    local name any=0
    while IFS= read -r name; do
        if (( ! any )); then
            printf 'available themes:\n'
            any=1
        fi
        printf '  %s\n' "${name}"
    done < <(list_theme_names)
    (( any )) || printf 'available themes: (none)\n'
}

validate_theme_or_die() {
    local name="$1"
    if [[ -z "${name}" ]]; then
        die 'theme name is required'
    fi
    if [[ ! "${name}" =~ ${THEME_NAME_RE} ]]; then
        printf 'showy-quota: invalid theme name: %s\n' "${name}" >&2
        printf 'showy-quota: names may contain only A-Z, a-z, 0-9, dot, underscore, and dash\n' >&2
        print_available_themes >&2
        exit 1
    fi
    if ! find_theme_path "${name}" >/dev/null; then
        printf 'showy-quota: unknown theme: %s\n' "${name}" >&2
        print_available_themes >&2
        exit 1
    fi
}

strip_matching_quotes() {
    local value="$1"
    if (( ${#value} >= 2 )) && [[ "${value}" == \"*\" && "${value}" == *\" ]]; then
        value="${value:1:${#value}-2}"
    elif (( ${#value} >= 2 )) && [[ "${value}" == \'*\' && "${value}" == *\' ]]; then
        value="${value:1:${#value}-2}"
    fi
    printf '%s' "${value}"
}

current_theme_value() {
    local line value current=""
    [[ -r "${CONFIG_FILE}" ]] || return 0

    while IFS= read -r line || [[ -n "${line}" ]]; do
        if [[ "${line}" =~ ^[[:space:]]*(export[[:space:]]+)?SHOWY_QUOTA_THEME= ]]; then
            value="${line#*=}"
            value="${value%%[[:space:]]*}"
            value=$(strip_matching_quotes "${value}")
            current="${value}"
        fi
    done < "${CONFIG_FILE}"

    [[ -n "${current}" ]] && printf '%s\n' "${current}"

    return 0
}

print_current_theme() {
    local current
    current=$(current_theme_value)
    printf '%s\n' "${current:-(none)}"
}

write_config_lines() {
    local mode="$1" theme="${2:-}"
    local tmp line last_index
    local -a lines=()
    local matched=0
    local wrote=0
    local i

    if [[ -f "${CONFIG_FILE}" ]]; then
        while IFS= read -r line || [[ -n "${line}" ]]; do
            lines+=("${line}")
        done < "${CONFIG_FILE}"
    fi

    for line in "${lines[@]}"; do
        if [[ "${line}" =~ ^[[:space:]]*(export[[:space:]]+)?SHOWY_QUOTA_THEME= ]]; then
            matched=1
            break
        fi
    done

    if [[ "${mode}" == "unset" && "${matched}" == 0 ]]; then
        return 0
    fi

    tmp=$(umask 077 && mktemp "${CONFIG_FILE}.tmp.XXXXXX") || die "cannot create temporary config next to ${CONFIG_FILE}"
    track_temp_file "${tmp}"
    if ! {
        for i in "${!lines[@]}"; do
            line="${lines[$i]}"
            if [[ "${line}" =~ ^([[:space:]]*)(export[[:space:]]+)?SHOWY_QUOTA_THEME= ]]; then
                if [[ "${mode}" == "set" && "${wrote}" == 0 ]]; then
                    printf '%s%sSHOWY_QUOTA_THEME=%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]:-}" "${theme}"
                    wrote=1
                fi
                continue
            fi
            printf '%s\n' "${line}"
        done

        if [[ "${mode}" == "set" && "${matched}" == 0 ]]; then
            if ((${#lines[@]} > 0)); then
                last_index=$((${#lines[@]} - 1))
                [[ -z "${lines[$last_index]}" ]] || printf '\n'
            fi
            printf 'SHOWY_QUOTA_THEME=%s\n' "${theme}"
        fi
    } > "${tmp}"; then
        die "cannot write temporary config next to ${CONFIG_FILE}"
    fi

    if ! mv -f -- "${tmp}" "${CONFIG_FILE}"; then
        die "cannot replace ${CONFIG_FILE}"
    fi
}

set_theme() {
    local name="$1"
    validate_theme_or_die "${name}"
    (umask 077 && mkdir -p -- "${CONFIG_DIR}") || die "cannot create ${CONFIG_DIR}"
    with_file_write_lock "${CONFIG_FILE}" write_config_lines set "${name}"
}

unset_theme() {
    [[ -d "${CONFIG_DIR}" ]] || return 0
    with_file_write_lock "${CONFIG_FILE}" write_config_lines unset
}

ordered_theme_names() {
    local current="${1:-}" name
    local printed_current=0

    if [[ -n "${current}" ]] && find_theme_path "${current}" >/dev/null; then
        printf '%s\n' "${current}"
        printed_current=1
    fi

    while IFS= read -r name; do
        if (( printed_current )) && [[ "${name}" == "${current}" ]]; then
            continue
        fi
        printf '%s\n' "${name}"
    done < <(list_theme_names)
}

print_fallback_selector() {
    local current="$1" name any=0
    printf 'Current theme: %s\n' "${current:-(none)}"
    printf '\nAvailable themes:\n'
    while IFS= read -r name; do
        any=1
        printf '  %s\n' "${name}"
    done < <(ordered_theme_names "${current}")
    (( any )) || printf '  (none)\n'
    printf '\nSet a theme:\n  showy-quota --set <name>\n'
    printf 'Unset persisted theme:\n  showy-quota --unset\n'
}

run_fzf_selector() {
    local current="$1" selection preview_cmd unset_cmd
    printf -v preview_cmd '%q --preview {}' "${SCRIPT_PATH}"
    printf -v unset_cmd '%q --unset' "${SCRIPT_PATH}"

    if selection=$(ordered_theme_names "${current}" | fzf \
        --prompt='theme> ' \
        --header='enter: save  esc: cancel  ctrl-x: clear theme  arrows/hjkl: browse' \
        --preview="${preview_cmd}" \
        --preview-window='right,60%,wrap' \
        --bind='h:up,j:down,k:up,l:down,up:up,down:down' \
        --bind="ctrl-x:execute(${unset_cmd})+abort"); then
        [[ -n "${selection}" ]] && set_theme "${selection}"
    fi
}

run_selector() {
    local current
    current=$(current_theme_value)
    if [[ -z "${SHOWY_QUOTA_TEST_NO_FZF:-}" ]] && [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
        run_fzf_selector "${current}"
    else
        print_fallback_selector "${current}"
    fi
}

preview_fixture_json() {
    cat <<'JSON'
[
  {"provider":"claude","usage":{
    "primary":  {"usedPercent":17,"resetsAt":"2099-01-01T03:29:00Z","windowMinutes":300},
    "secondary":{"usedPercent":70,"resetsAt":"2099-01-03T00:00:00Z","windowMinutes":10080}
  }},
  {"provider":"codex","usage":{
    "primary":  {"usedPercent":92,"resetsAt":"2099-01-01T00:23:00Z","windowMinutes":10080},
    "secondary":{"usedPercent":35,"resetsAt":"2099-01-04T12:00:00Z","windowMinutes":10080}
  }}
]
JSON
}

preview_theme() {
    local name="$1"
    validate_theme_or_die "${name}"

    SHOWY_QUOTA_THEME="${name}" \
        SHOWY_QUOTA_NO_CONFIG=1 \
        SHOWY_QUOTA_FORCE_COLOR=1 \
        SHOWY_QUOTA_NOW_EPOCH=4070908800 \
        "${RENDERER}" --json - < <(preview_fixture_json)
}

# --diagnose output is meant to be pasted into bug reports, so every absolute
# path and URL in it reaches whoever receives the paste. `--redact` keeps the
# parts that help a maintainer and drops the parts that only describe this
# machine: a path collapses to its basename, and a URL keeps its scheme and
# port but loses the host. Values that carry no local layout (counts, provider
# ids, theme names, booleans) are never touched.
#
# Anything path-shaped collapses, not just absolute paths. `~alice/x` and
# `../private/x` name a user and a layout just as plainly as `/Users/alice/x`,
# and a redactor that misses them while the payload still reports
# `"redacted": true` is worse than no redaction: it tells the user the paste is
# safe. A bare word with no separator (`codexbar`, `jq`) is a command name, not
# a path, and stays readable.
DIAGNOSE_REDACT=0

# Mask every path-shaped and URL-shaped token in free text. Shared by the
# single-value helper and the state walk so both agree on what a mask is, and
# so a value that mixes prose with a path (`cb_version` is whatever the
# configured binary prints) cannot slip through by not looking like one token.
diagnose_mask_text() {
    sed -E \
        -e 's#/(Users|home)/[^/[:space:]]*#<home>#g' \
        -e 's#(~[A-Za-z0-9._-]*|\.\.?)(/[A-Za-z0-9._@+-]+)*/([A-Za-z0-9._@+-]+)#<path>/\3#g' \
        -e 's#([a-zA-Z][a-zA-Z0-9+.-]*)://([^/[:space:]@]*@)?(\\?\[[^]]*\\?]|[^/:[:space:]]+)(:[0-9]+)?#\1://<host>\4#g' \
        -e 's#(/[A-Za-z0-9._@+-]+){1,}/([A-Za-z0-9._@+-]+)#<path>/\2#g' \
        -e 's#~[A-Za-z0-9._-]+#<home>#g'
}

diagnose_redact_value() {
    local value="$1" scheme rest hostport port
    if (( ! DIAGNOSE_REDACT )) || [[ -z "${value}" ]]; then
        printf '%s' "${value}"
        return 0
    fi
    # The URL arm exists to keep the port, which the generic masker cannot do
    # as precisely, so it only claims a value that is nothing but a URL. A
    # `://` anywhere else (prose plus a URL, or a path followed by a URL) used
    # to make everything before the scheme a literal prefix and leak it.
    if [[ "${value}" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*://[^[:space:]]*$ ]]; then
        scheme="${value%%://*}"
        rest="${value#*://}"
        # The authority ends at the first `/`, `?` or `#`. Splitting on `/`
        # alone leaves `8080?token=1` in the port slot, which fails the
        # numeric test and silently drops the port the maintainer needs.
        hostport="${rest%%[/?#]*}"
        port="${hostport##*:}"
        if [[ "${port}" == "${hostport}" || ! "${port}" =~ ^[0-9]+$ ]]; then
            printf '%s://<host>' "${scheme}"
        else
            printf '%s://<host>:%s' "${scheme}" "${port}"
        fi
        return 0
    fi
    case "${value}" in
        # Single clean tokens keep their basename, which is the useful part of
        # a diagnostic path. Anything else — whitespace, or a mix of shapes —
        # goes through the generic masker rather than a prefix-preserving arm.
        *[[:space:]]*) printf '%s' "${value}" | diagnose_mask_text ;;
        # The tilde arms precede the generic path arm: `~alice/x` also matches
        # `*/*`, so ordering them after it left them unreachable and reported a
        # home path as an ordinary one. `~alice` alone has no separator, so a
        # basename strip returns the tilde form unchanged and would print the
        # account name; only the multi-segment form has a basename worth keeping.
        ~*/*) printf '<home>/%s' "${value##*/}" ;;
        ~*) printf '<home>' ;;
        /*|*/*) printf '<path>/%s' "${value##*/}" ;;
        *)  printf '%s' "${value}" ;;
    esac
}

# `--redact` must also cover values showy-quota did not compose. Provider error
# messages arrive from CodexBar and can quote the URL or path they failed
# against, and they reach both modes through the `state` payload without
# passing diagnose_redact_value. showy-quota-state already masks secret-shaped
# values; hosts and absolute paths are ours to mask. This walks every string
# leaf, so a new state field cannot bypass it by being added later, and leaves
# non-strings untouched so the key/type contract holds.
#
# jq is a hard requirement, so a failure here means a broken jq, not a missing
# value: fail closed to `null` rather than emit the unredacted payload.
diagnose_redact_json() {
    local payload
    payload="$(cat)"
    if (( ! DIAGNOSE_REDACT )) || [[ -z "${payload}" || "${payload}" == null ]]; then
        printf '%s' "${payload}"
        return 0
    fi
    # The text mode pipes stderr through here too, so the payload is not always
    # JSON. Mask at the text level in that case: dropping a state error would
    # trade a disclosure bug for a diagnostic one.
    #
    # The host class accepts a bracketed literal, optionally backslash-escaped
    # because `lib/common.sh` reports rejected values with `%q`, before the
    # colon-free form. Matching `[^/:]+` first would stop at the first inner
    # colon and leave the rest of an IPv6 address in the output.
    #
    # The home prefixes run first and deliberately consume a whole segment up
    # to the next `/`, including spaces and punctuation. `/Users/` and `/home/`
    # make the boundary unambiguous, so the account name cannot survive as a
    # fragment the way a narrow ASCII segment class let `/Users/alice x` and
    # `/Users/alice%corp` do.
    #
    # Known limit: a path inside free prose has no unambiguous end, so an
    # unanchored relative fragment (`foo/bar`) is left alone rather than
    # mangling every message containing `and/or`, `read/write` or `TCP/IP`.
    # That residue carries no account name and no home directory. `--redact`
    # is a paste-safety aid for text this program did not compose, not a
    # guarantee against a determined leak through free-form upstream output.
    #
    if ! printf '%s' "${payload}" | jq -e . >/dev/null 2>&1; then
        printf '%s' "${payload}" | diagnose_mask_text
        return 0
    fi
    printf '%s' "${payload}" | jq 'def mask:
  if type == "string" then
    gsub("/(?:Users|home)/[^/]*"; "<home>")
    | gsub("(?<t>~[A-Za-z0-9._-]*|\\.\\.?)(?:/[A-Za-z0-9._@+-]+)*/(?<b>[A-Za-z0-9._@+-]+)"; "<path>/\(.b)")
    | gsub("(?<s>[a-zA-Z][a-zA-Z0-9+.-]*)://(?:[^/@\\s]*@)?(?:\\\\?\\[[^\\]\\s]*\\\\?\\]|[^/:\\s]+)(?<p>:[0-9]+)?"; "\(.s)://<host>\(.p // "")")
    | gsub("(?<d>(?:/[A-Za-z0-9._@+-]+){1,})/(?<b>[A-Za-z0-9._@+-]+)"; "<path>/\(.b)")
    | gsub("~(?<u>[A-Za-z0-9._-]+)"; "<home>")
  else . end;
walk(mask)' 2>/dev/null || {
        printf 'null'
        printf 'showy-quota: --redact could not filter state; reporting null\n' >&2
    }
}

print_tool_path() {
    local name="$1" path
    if path=$(command -v "${name}" 2>/dev/null); then
        printf '  %-12s %s\n' "${name}" "$(diagnose_redact_value "${path}")"
    else
        printf '  %-12s (missing)\n' "${name}"
    fi
}

json_string() {
    jq -Rn --arg value "$1" '$value'
}

json_number_or_null() {
    local value="$1"
    if [[ "${value}" =~ ^[0-9]+$ ]]; then
        printf '%s' "${value}"
    else
        printf 'null'
    fi
}

# Cold-path checker. The defaults block supplies the normal knob names. Some
# integrations consume knobs directly without declaring a shell default; the
# config reference supplies those names. Keep both scans here, not on render.
config_issues_prepare() {
    [[ "${CONFIG_ISSUES_READY:-0}" == 1 ]] && return 0
    if (( DIAGNOSE_REDACT )); then
        # The loader warns on stderr with the raw rejected value (a path or URL
        # in a hostile theme name, say). Each of those is also recorded as an
        # issue and reported through the redacted output, so drop the raw copy.
        load_state_libs 2>/dev/null || true
        showy_quota_check_deferred_config 2>/dev/null
    else
        load_state_libs || true
        showy_quota_check_deferred_config
    fi
    # The shared loader leaves a missing, valid theme as an error for renderers.
    # The checker must still report it alongside the other config issues.
    if [[ -n "${SHOWY_QUOTA_THEME:-}" && "${SHOWY_QUOTA_THEME}" =~ ${THEME_NAME_RE} ]] \
        && ! find_theme_path "${SHOWY_QUOTA_THEME}" >/dev/null; then
        showy_quota_record_config_issue SHOWY_QUOTA_THEME "${SHOWY_QUOTA_THEME}" "" missing_theme
    fi
    local line key in_defaults=0
    local -A known=() seen=()
    while IFS= read -r line; do
        case "${line}" in
            '# ── defaults ──'*) in_defaults=1; continue ;;
            '# ── numeric config validation ──'*) break ;;
        esac
        (( in_defaults )) || continue
        # shellcheck disable=SC2016
        if [[ "${line}" == ': "${SHOWY_QUOTA_'* ]]; then
            # shellcheck disable=SC2016
            key="${line#*'${'}"
            known["${key%%[:=]*}"]=1
        elif [[ "${line}" =~ ^[[:space:]]*(SHOWY_QUOTA_[A-Z0-9_]+)= ]]; then
            known["${BASH_REMATCH[1]}"]=1
        fi
    done < "${REPO_ROOT}/lib/common.sh"
    if [[ -r "${REPO_ROOT}/share/config.env.example" ]]; then
        while IFS= read -r line; do
            if [[ "${line}" =~ ^#[[:space:]]+(SHOWY_QUOTA_[A-Z0-9_]+)= ]]; then
                known["${BASH_REMATCH[1]}"]=1
            fi
        done < "${REPO_ROOT}/share/config.env.example"
    fi
    if [[ "${SHOWY_QUOTA_CONFIG_LOADED:-0}" == 1 ]]; then
        while IFS= read -r line || [[ -n "${line}" ]]; do
            if [[ "${line}" =~ ^[[:space:]]*(export[[:space:]]+)?(SHOWY_QUOTA_[A-Z0-9_]+)= ]]; then
                key="${BASH_REMATCH[2]}"
                if [[ -z "${known[${key}]+x}" && -z "${seen[${key}]+x}" ]]; then
                    showy_quota_record_config_issue "${key}" "${!key-}" "" unknown_key
                    seen["${key}"]=1
                fi
            fi
        done < "${CONFIG_FILE}"
    elif [[ -z "${SHOWY_QUOTA_NO_CONFIG:-}" && -e "${CONFIG_FILE}" ]]; then
        showy_quota_record_config_issue config.env "${CONFIG_FILE}" "(not loaded)" invalid_value
    fi
    CONFIG_ISSUES_READY=1
}

config_issues_json() {
    command -v jq >/dev/null 2>&1 || die 'jq is required for config JSON'
    config_issues_prepare
    local i
    for i in "${!SHOWY_QUOTA_CONFIG_ISSUES[@]}"; do
        jq -n -c \
            --arg key "${SHOWY_QUOTA_CONFIG_ISSUES[$i]}" \
            --arg raw "$(diagnose_redact_value "${SHOWY_QUOTA_CONFIG_RAW[$i]}")" \
            --arg effective "$(diagnose_redact_value "${SHOWY_QUOTA_CONFIG_EFFECTIVE[$i]}")" \
            --arg reason "${SHOWY_QUOTA_CONFIG_REASONS[$i]}" \
            '{key:$key, raw:$raw, effective:(if $reason == "unknown_key" then null else $effective end), reason:$reason}'
    done | jq -s '.'
}

config_issues_text() {
    config_issues_prepare
    local i
    printf 'config issues: %s\n' "${#SHOWY_QUOTA_CONFIG_ISSUES[@]}"
    for i in "${!SHOWY_QUOTA_CONFIG_ISSUES[@]}"; do
        if [[ "${SHOWY_QUOTA_CONFIG_REASONS[$i]}" == unknown_key ]]; then
            printf '  %s=%s: unknown_key (ignored)\n' \
                "${SHOWY_QUOTA_CONFIG_ISSUES[$i]}" "$(diagnose_redact_value "${SHOWY_QUOTA_CONFIG_RAW[$i]}")"
        else
            printf '  %s=%s: %s; effective=%s\n' \
                "${SHOWY_QUOTA_CONFIG_ISSUES[$i]}" \
                "$(diagnose_redact_value "${SHOWY_QUOTA_CONFIG_RAW[$i]}")" \
                "${SHOWY_QUOTA_CONFIG_REASONS[$i]}" \
                "$(diagnose_redact_value "${SHOWY_QUOTA_CONFIG_EFFECTIVE[$i]}")"
        fi
    done
}

check_config() {
    local json_mode=0
    shift
    while (($#)); do
        case "$1" in
            --json) json_mode=1 ;;
            --redact) DIAGNOSE_REDACT=1 ;;
            -h|--help)
                printf 'Usage: showy-quota --check-config [--json] [--redact]\n'
                return 0 ;;
            *) usage_error '--check-config only accepts --json and --redact' ;;
        esac
        shift
    done
    config_issues_prepare
    if (( json_mode )); then
        local issues
        issues="$(config_issues_json)"
        jq -n --arg file "$(diagnose_redact_value "${CONFIG_FILE}")" \
            --argjson issues "${issues}" \
            '{configFile:$file, count:($issues|length), issues:$issues}'
    else
        printf 'config file: %s\n' "$(diagnose_redact_value "${CONFIG_FILE}")"
        config_issues_text
    fi
    (( ${#SHOWY_QUOTA_CONFIG_ISSUES[@]} == 0 ))
}

diagnose_env_vars() {
    printf '%s\n' \
        SHOWY_QUOTA_REFRESH_SECONDS \
        SHOWY_QUOTA_LOCK_WAIT_TENTHS \
        SHOWY_QUOTA_CACHE_DIR \
        SHOWY_QUOTA_CODEXBAR_BIN \
        SHOWY_QUOTA_CODEXBAR_SERVE_URL \
        SHOWY_QUOTA_CODEXBAR_SERVE_TIMEOUT_SECONDS \
        SHOWY_QUOTA_CODEXBAR_SERVE_USAGE_TIMEOUT_SECONDS \
        SHOWY_QUOTA_CODEXBAR_SERVE_REFRESH_SECONDS \
        SHOWY_QUOTA_PROVIDERS \
        SHOWY_QUOTA_PROVIDERS_EXCLUDE \
        SHOWY_QUOTA_PROVIDER_ORDER \
        SHOWY_QUOTA_INCLUDE_STATUS \
        SHOWY_QUOTA_PROMPT_FETCH \
        SHOWY_QUOTA_THEME \
        SHOWY_QUOTA_TIME_WARN_MINUTES \
        SHOWY_QUOTA_DEBUG \
        SHOWY_QUOTA_FORCE_COLOR \
        SHOWY_QUOTA_NO_CONFIG \
        SHOWY_QUOTA_SKETCHYBAR_PROVIDER_ICON_MODE \
        SHOWY_QUOTA_SKETCHYBAR_PLACEMENT \
        SHOWY_QUOTA_SKETCHYBAR_UPDATE_FREQ \
        SHOWY_QUOTA_ZELLIJ_WIDGET \
        SHOWY_QUOTA_ZELLIJ_PIPE_INTERVAL \
        SHOWY_QUOTA_ZELLIJ_BIN
}

diagnose_env_json() {
    local first=1 var value
    printf '{'
    while IFS= read -r var; do
        [[ -n "${!var:-}" ]] || continue
        value=$(json_string "$(diagnose_redact_value "${!var}")")
        (( first )) || printf ','
        first=0
        printf '"%s":%s' "${var}" "${value}"
    done < <(diagnose_env_vars)
    printf '}'
}

diagnose_tools_json() {
    local first=1 name path
    printf '{'
    for name in "$@"; do
        (( first )) || printf ','
        first=0
        if path=$(command -v "${name}" 2>/dev/null); then
            printf '"%s":{"available":true,"path":%s}' "${name}" "$(json_string "$(diagnose_redact_value "${path}")")"
        else
            printf '"%s":{"available":false,"path":null}' "${name}"
        fi
    done
    printf '}'
}

# Probe the configured CodexBar serve for --diagnose. Only /health is read: it
# proves the serve process answers without asking it for /usage, which may
# trigger a provider collection. Sets SERVE_PROBE_URL, SERVE_PROBE_STATUS
# (disabled|non-local|no-curl|reachable|unreachable) and SERVE_PROBE_VERSION.
diagnose_serve_probe() {
    local url body
    SERVE_PROBE_URL=""
    SERVE_PROBE_STATUS=""
    SERVE_PROBE_VERSION=""
    # Resolve config.env + shared defaults in a subshell so they do not leak
    # into this process and show up in the "set values only" env listing.
    url="$(load_state_libs >/dev/null 2>&1; printf '%s' "${SHOWY_QUOTA_CODEXBAR_SERVE_URL-}")"
    url="${url%/}"
    SERVE_PROBE_URL="${url}"
    if [[ -z "${url}" ]]; then
        SERVE_PROBE_STATUS=disabled
    elif ! [[ "${url}" =~ ^http://(127[.]0[.]0[.]1|localhost|\[::1\])(:[0-9]+)?$ ]]; then
        # showy-quota-fetch ignores non-local serve URLs; never probe them.
        SERVE_PROBE_STATUS=non-local
    elif ! command -v curl >/dev/null 2>&1; then
        SERVE_PROBE_STATUS=no-curl
    elif body="$(curl --fail --silent --max-time 2 "${url}/health" 2>/dev/null)"; then
        SERVE_PROBE_STATUS=reachable
        if command -v jq >/dev/null 2>&1; then
            SERVE_PROBE_VERSION="$(jq -r 'if type == "object" then (.version // empty | tostring) else empty end' <<< "${body}" 2>/dev/null || true)"
        fi
    else
        SERVE_PROBE_STATUS=unreachable
    fi
}

diagnose_json() {
    command -v jq >/dev/null 2>&1 || die 'jq is required for --diagnose --json'

    local fetch_bin state_bin cache_path cache_age cache_size_json state_json provider_decisions_json config_status config_readable
    local env_json required_tools_json optional_tools_json cb cb_path cb_version cb_available cb_cache_count_json
    fetch_bin="${SCRIPT_DIR}/showy-quota-fetch"
    state_bin="${SCRIPT_DIR}/showy-quota-state"

    cache_path=""
    cache_age=""
    cache_size_json=null
    if [[ -x "${fetch_bin}" ]]; then
        cache_path="$("${fetch_bin}" --path 2>/dev/null || true)"
        cache_age="$("${fetch_bin}" --age 2>/dev/null || true)"
        if [[ -n "${cache_path}" && -f "${cache_path}" ]]; then
            cache_size_json=$(json_number_or_null "$(wc -c < "${cache_path}" 2>/dev/null | tr -d ' ' || true)")
        fi
    fi

    if [[ -x "${state_bin}" ]]; then
        state_json="$("${state_bin}" 2>/dev/null | diagnose_redact_json || printf 'null')"
        if ! jq -e 'type == "object"' >/dev/null 2>&1 <<< "${state_json}"; then
            state_json=null
        fi
    else
        state_json=null
    fi
    provider_decisions_json='[]'
    if [[ -x "${state_bin}" ]]; then
        provider_decisions_json="$("${state_bin}" --no-fetch --explain --json 2>/dev/null | diagnose_redact_json || printf '[]')"
        if ! jq -e 'type == "array"' >/dev/null 2>&1 <<< "${provider_decisions_json}"; then
            provider_decisions_json='[]'
        fi
    fi

    if [[ -r "${CONFIG_FILE}" ]]; then
        config_status=readable
        config_readable=true
    elif [[ -e "${CONFIG_FILE}" ]]; then
        config_status=unreadable
        config_readable=false
    else
        config_status=absent
        config_readable=null
    fi

    cb="${SHOWY_QUOTA_CODEXBAR_BIN:-codexbar}"
    cb_available=false
    cb_path=""
    cb_version=""
    if cb_path=$(command -v "${cb}" 2>/dev/null); then
        cb_available=true
        # SHOWY_QUOTA_MANAGE_SERVE spawns this exact binary, so a bug report
        # needs to name which build was running.
        cb_version="$("${cb}" --version 2>/dev/null | head -n1 || true)"
    fi
    cb_cache_count_json=null
    if [[ -n "${cache_path}" && -f "${cache_path}" ]]; then
        cb_cache_count_json=$(jq '(if type == "object" then (.providers // []) else . end) | if type == "array" then length else null end' "${cache_path}" 2>/dev/null || printf 'null')
    fi

    env_json=$(diagnose_env_json)
    required_tools_json=$(diagnose_tools_json bash jq codexbar)
    optional_tools_json=$(diagnose_tools_json curl flock sketchybar magick rsvg-convert zellij tmux fzf)
    local SERVE_PROBE_URL SERVE_PROBE_STATUS SERVE_PROBE_VERSION
    diagnose_serve_probe

    jq -n \
        --arg showyQuota "$(diagnose_redact_value "${SCRIPT_PATH}")" \
        --arg repoRoot "$(diagnose_redact_value "${REPO_ROOT}")" \
        --arg bashVersion "${BASH_VERSION:-unknown}" \
        --arg uname "$(uname -srm 2>/dev/null || printf 'unknown')" \
        --arg configFile "$(diagnose_redact_value "${CONFIG_FILE}")" \
        --arg configStatus "${config_status}" \
        --argjson configReadable "${config_readable}" \
        --arg theme "$(diagnose_redact_value "$(current_theme_value 2>/dev/null || true)")" \
        --arg fetchBin "$(diagnose_redact_value "${fetch_bin}")" \
        --arg cachePath "$(diagnose_redact_value "${cache_path}")" \
        --arg cacheAge "${cache_age}" \
        --argjson cacheSize "${cache_size_json}" \
        --argjson state "${state_json}" \
        --argjson providerDecisions "${provider_decisions_json}" \
        --argjson configIssues "$(config_issues_json)" \
        --argjson envKnobs "${env_json}" \
        --argjson requiredTools "${required_tools_json}" \
        --argjson optionalTools "${optional_tools_json}" \
        --arg codexbarCommand "$(diagnose_redact_value "${cb}")" \
        --arg codexbarPath "$(diagnose_redact_value "${cb_path}")" \
        --arg codexbarVersion "$(diagnose_redact_value "${cb_version}")" \
        --argjson codexbarAvailable "${cb_available}" \
        --argjson cachedProviderCount "${cb_cache_count_json}" \
        --arg serveUrl "$(diagnose_redact_value "${SERVE_PROBE_URL}")" \
        --arg serveStatus "${SERVE_PROBE_STATUS}" \
        --arg serveVersion "$(diagnose_redact_value "${SERVE_PROBE_VERSION}")" \
        --argjson redacted "$( (( DIAGNOSE_REDACT )) && printf 'true' || printf 'false' )" \
        '{
            schemaVersion: 1,
            redacted: $redacted,
            paths: {
                showyQuota: $showyQuota,
                repoRoot: $repoRoot,
                fetch: $fetchBin,
                cache: (if $cachePath == "" then null else $cachePath end),
                config: $configFile
            },
            runtime: {
                bash: $bashVersion,
                uname: $uname
            },
            tools: {
                required: $requiredTools,
                optional: $optionalTools
            },
            config: {
                path: $configFile,
                status: $configStatus,
                readable: $configReadable,
                theme: (if $theme == "" then null else $theme end)
            },
            cache: {
                path: (if $cachePath == "" then null else $cachePath end),
                ageSeconds: (if ($cacheAge | test("^[0-9]+$")) then ($cacheAge | tonumber) else null end),
                sizeBytes: $cacheSize
            },
            state: $state,
            configIssues: {count: ($configIssues | length), issues: $configIssues},
            providerDecisions: $providerDecisions,
            env: $envKnobs,
            codexbarProbe: {
                command: $codexbarCommand,
                available: $codexbarAvailable,
                path: (if $codexbarPath == "" then null else $codexbarPath end),
                version: (if $codexbarVersion == "" then null else $codexbarVersion end),
                cachedProviderCount: $cachedProviderCount
            },
            serveProbe: {
                url: (if $serveUrl == "" then null else $serveUrl end),
                status: $serveStatus,
                healthReachable: ($serveStatus == "reachable"),
                version: (if $serveVersion == "" then null else $serveVersion end)
            }
        }'
}

diagnose() {
    local fetch_bin state_bin cache_path cache_age
    fetch_bin="${SCRIPT_DIR}/showy-quota-fetch"
    state_bin="${SCRIPT_DIR}/showy-quota-state"

    printf '## showy-quota diagnose\n'
    if (( DIAGNOSE_REDACT )); then
        printf 'redacted:     yes (paths shown as basenames, URL hosts hidden)\n'
    else
        printf 'redacted:     no — re-run with "--diagnose --redact" before pasting this anywhere public\n'
    fi
    printf 'showy-quota:    %s\n' "$(diagnose_redact_value "${SCRIPT_PATH}")"
    printf 'repo root:    %s\n' "$(diagnose_redact_value "${REPO_ROOT}")"
    printf 'bash:         %s\n' "${BASH_VERSION:-unknown}"
    printf 'uname:        %s\n' "$(uname -srm 2>/dev/null || printf 'unknown')"

    printf '\n# Required tools\n'
    print_tool_path bash
    print_tool_path jq
    print_tool_path codexbar
    printf '\n# Optional tools\n'
    print_tool_path curl
    print_tool_path flock
    print_tool_path sketchybar
    print_tool_path magick
    print_tool_path rsvg-convert
    print_tool_path zellij
    print_tool_path tmux
    print_tool_path fzf

    printf '\n# Config\n'
    local config_shown
    config_shown="$(diagnose_redact_value "${CONFIG_FILE}")"
    if [[ -r "${CONFIG_FILE}" ]]; then
        printf 'config:       %s (readable)\n' "${config_shown}"
    elif [[ -e "${CONFIG_FILE}" ]]; then
        printf 'config:       %s (exists, unreadable)\n' "${config_shown}"
    else
        printf 'config:       %s (none — defaults in effect)\n' "${config_shown}"
    fi
    printf 'theme:        %s\n' "$(diagnose_redact_value "$(current_theme_value 2>/dev/null || printf '(none)')")"
    printf '\n# Config issues\n'
    config_issues_text

    printf '\n# Cache\n'
    if [[ -x "${fetch_bin}" ]]; then
        cache_path="$("${fetch_bin}" --path 2>/dev/null || printf '(unknown)')"
        cache_age="$("${fetch_bin}" --age 2>/dev/null || printf '(unknown)')"
        printf 'cache file:   %s\n' "$(diagnose_redact_value "${cache_path}")"
        printf 'cache age:    %ss\n' "${cache_age}"
        if [[ -f "${cache_path}" ]]; then
            printf 'cache size:   %s bytes\n' "$(wc -c < "${cache_path}" 2>/dev/null | tr -d ' ' || printf 'unknown')"
        else
            printf 'cache size:   (file absent)\n'
        fi
    else
        printf 'cache:        showy-quota-fetch missing or non-executable: %s\n' "$(diagnose_redact_value "${fetch_bin}")"
    fi

    printf '\n# State\n'
    if [[ -x "${state_bin}" ]]; then
        "${state_bin}" 2>&1 | diagnose_redact_json | sed 's/^/  /'
    else
        printf '  showy-quota-state missing or non-executable: %s\n' "$(diagnose_redact_value "${state_bin}")"
    fi

    printf '\n# Provider decisions (cached)\n'
    if [[ -x "${state_bin}" ]]; then
        "${state_bin}" --no-fetch --explain --json 2>/dev/null | diagnose_redact_json | sed 's/^/  /'
    else
        printf '  []\n'
    fi

    printf '\n# Env knobs (set values only)\n'
    local var
    while IFS= read -r var; do
        if [[ -n "${!var:-}" ]]; then
            printf '  %s=%s\n' "${var}" "$(diagnose_redact_value "${!var}")"
        fi
    done < <(diagnose_env_vars)

    printf '\n# CodexBar probe\n'
    local cb="${SHOWY_QUOTA_CODEXBAR_BIN:-codexbar}"
    if ! command -v "${cb}" >/dev/null 2>&1; then
        printf 'codexbar binary not on PATH (set SHOWY_QUOTA_CODEXBAR_BIN or install codexbar; serve-only setups need the serve below)\n'
    else
        # SHOWY_QUOTA_MANAGE_SERVE (default 1) spawns this exact binary, so a
        # bug report needs to name which build was running.
        printf 'codexbar:     %s (%s)\n' \
            "$(diagnose_redact_value "$("${cb}" --version 2>/dev/null | head -n1 || printf 'version unknown')")" \
            "$(diagnose_redact_value "$(command -v "${cb}")")"
        printf 'manage serve: %s\n' "$(diagnose_redact_value "${SHOWY_QUOTA_MANAGE_SERVE:-1}")"
        if ! command -v jq >/dev/null 2>&1; then
            printf 'jq missing — cannot count providers\n'
        elif [[ -f "${SHOWY_QUOTA_USAGE_FILE:-${HOME}/.cache/showy-quota/usage.json}" ]]; then
            local cache_file count
            cache_file="${SHOWY_QUOTA_USAGE_FILE:-${HOME}/.cache/showy-quota/usage.json}"
            count=$(jq '(if type == "object" then (.providers // []) else . end) | length' "${cache_file}" 2>/dev/null || printf '?')
            printf 'cached provider count = %s (from %s)\n' "${count}" "$(diagnose_redact_value "${cache_file}")"
            printf '(skipping live %s usage probe; rerun bin/showy-quota-fetch --refresh to refresh)\n' "$(diagnose_redact_value "${cb}")"
        else
            printf 'no cache yet; run bin/showy-quota-fetch --refresh to populate, then re-run --diagnose\n'
        fi
    fi

    printf '\n# CodexBar serve\n'
    local SERVE_PROBE_URL SERVE_PROBE_STATUS SERVE_PROBE_VERSION
    diagnose_serve_probe
    case "${SERVE_PROBE_STATUS}" in
        disabled)
            printf 'serve:        disabled (SHOWY_QUOTA_CODEXBAR_SERVE_URL is empty)\n' ;;
        non-local)
            printf 'serve:        %s ignored (only loopback serve URLs are used)\n' "$(diagnose_redact_value "${SERVE_PROBE_URL}")" ;;
        no-curl)
            printf 'serve:        %s not probed (curl missing)\n' "$(diagnose_redact_value "${SERVE_PROBE_URL}")" ;;
        reachable)
            printf 'serve:        %s/health reachable%s\n' "$(diagnose_redact_value "${SERVE_PROBE_URL}")" \
                "${SERVE_PROBE_VERSION:+ (version $(diagnose_redact_value "${SERVE_PROBE_VERSION}"))}" ;;
        *)
            printf 'serve:        %s/health unreachable\n' "$(diagnose_redact_value "${SERVE_PROBE_URL}")" ;;
    esac
}

zellij_permissions_file() {
    if [[ -n "${SHOWY_QUOTA_ZELLIJ_PERMISSIONS_FILE:-}" ]]; then
        # grant_zellij writes a KDL block to this path; require an absolute
        # *.kdl path so an attacker-set env var cannot redirect the write to a
        # shell rc, LaunchAgent plist, ~/.ssh/authorized_keys, cron file, etc.
        if [[ "${SHOWY_QUOTA_ZELLIJ_PERMISSIONS_FILE}" != /*.kdl ]]; then
            die "SHOWY_QUOTA_ZELLIJ_PERMISSIONS_FILE must be an absolute path to a .kdl file: ${SHOWY_QUOTA_ZELLIJ_PERMISSIONS_FILE}"
        fi
        printf '%s' "${SHOWY_QUOTA_ZELLIJ_PERMISSIONS_FILE}"
        return 0
    fi
    local dir
    case "$(uname -s 2>/dev/null || printf 'unknown')" in
        Darwin) dir="${HOME}/Library/Caches/org.Zellij-Contributors.Zellij" ;;
        *)      dir="${XDG_CACHE_HOME:-${HOME}/.cache}/zellij" ;;
    esac
    printf '%s/permissions.kdl' "${dir}"
}

# Expand a leading ~ and make the path absolute without resolving symlinks,
# matching how Zellij derives a plugin's permission-cache key (shellexpand only).
resolve_abs_path() {
    local path="$1" tilde='~'
    if [[ "${path}" == "${tilde}" ]]; then
        path="${HOME}"
    elif [[ "${path}" == "${tilde}/"* ]]; then
        path="${HOME}/${path:2}"
    fi
    [[ "${path}" == /* ]] || path="$(pwd -P)/${path}"
    printf '%s' "${path}"
}

ZELLIJ_PERMISSION_BLOCK_RE='^[[:space:]]*"?([^"{]*[^"[:space:]{])"?[[:space:]]*\{[[:space:]]*$'
ZELLIJ_PERMISSION_CLOSE_RE='^[[:space:]]*\}[[:space:]]*$'

# Rebuild a permissions file from the snapshot held under its write lock.
write_zellij_permissions() {
    local perms_file="$1" section="keys" value
    shift
    local block_re="${ZELLIJ_PERMISSION_BLOCK_RE}"
    local close_re="${ZELLIJ_PERMISSION_CLOSE_RE}"
    local -a keys=() permissions=() kept=()
    local skipping=0 line name key managed last permission tmp

    while (($#)); do
        value="$1"
        shift
        if [[ "${value}" == "--" && "${section}" == "keys" ]]; then
            section="permissions"
        elif [[ "${section}" == "keys" ]]; then
            keys+=("${value}")
        else
            permissions+=("${value}")
        fi
    done

    if [[ -f "${perms_file}" ]]; then
        while IFS= read -r line || [[ -n "${line}" ]]; do
            if (( skipping )); then
                [[ "${line}" =~ ${close_re} ]] && skipping=0
                continue
            fi
            if [[ "${line}" =~ ${block_re} ]]; then
                name="${BASH_REMATCH[1]}"
                managed=0
                for key in "${keys[@]}"; do
                    [[ "${name}" == "${key}" ]] && { managed=1; break; }
                done
                if (( managed )); then
                    skipping=1
                    continue
                fi
            fi
            kept+=("${line}")
        done < "${perms_file}"
    fi

    # Drop trailing blank lines so appended blocks sit flush.
    while ((${#kept[@]})); do
        last=$(( ${#kept[@]} - 1 ))
        [[ -z "${kept[$last]}" ]] || break
        unset "kept[$last]"
    done

    tmp="$(umask 077 && mktemp "${perms_file}.tmp.XXXXXX")" || die "cannot create temporary file next to ${perms_file}"
    track_temp_file "${tmp}"
    if ! {
        if ((${#kept[@]})); then printf '%s\n' "${kept[@]}"; fi
        for key in "${keys[@]}"; do
            printf '"%s" {\n' "${key}"
            for permission in "${permissions[@]}"; do
                printf '    %s\n' "${permission}"
            done
            printf '}\n'
        done
    } > "${tmp}"; then
        die "cannot write temporary file next to ${perms_file}"
    fi
    if ! mv -f -- "${tmp}" "${perms_file}"; then
        die "cannot replace ${perms_file}"
    fi
}

# Inspect complete blocks without opening a lock or creating a cache directory.
# Report the last complete block when a key appears more than once.
read_zellij_permission_status() {
    local perms_file="$1" section="keys" value line name permission expected
    local index=-1 i matched complete_block
    local -a keys=() expected_permissions=() seen=() granted=() complete=() block_permissions=()
    shift
    while (($#)); do
        value="$1"
        shift
        if [[ "${value}" == "--" && "${section}" == "keys" ]]; then
            section="permissions"
        elif [[ "${section}" == "keys" ]]; then
            keys+=("${value}")
        else
            expected_permissions+=("${value}")
        fi
    done

    for i in "${!keys[@]}"; do
        seen[i]=0
        granted[i]=""
        complete[i]=0
    done

    if [[ -f "${perms_file}" && -r "${perms_file}" ]]; then
        while IFS= read -r line || [[ -n "${line}" ]]; do
            if (( index >= 0 )); then
                if [[ "${line}" =~ ${ZELLIJ_PERMISSION_CLOSE_RE} ]]; then
                    seen[index]=1
                    granted[index]="${block_permissions[*]}"
                    complete_block=1
                    for expected in "${expected_permissions[@]}"; do
                        matched=0
                        for permission in "${block_permissions[@]}"; do
                            [[ "${permission}" == "${expected}" ]] && { matched=1; break; }
                        done
                        (( matched )) || complete_block=0
                    done
                    complete[index]="${complete_block}"
                    index=-1
                elif [[ "${line}" =~ ^[[:space:]]*([A-Za-z][A-Za-z0-9]*)[[:space:]]*$ ]]; then
                    block_permissions+=("${BASH_REMATCH[1]}")
                fi
                continue
            fi
            if [[ "${line}" =~ ${ZELLIJ_PERMISSION_BLOCK_RE} ]]; then
                name="${BASH_REMATCH[1]}"
                for i in "${!keys[@]}"; do
                    if [[ "${name}" == "${keys[i]}" ]]; then
                        index="${i}"
                        block_permissions=()
                        break
                    fi
                done
            fi
        done < "${perms_file}"
    fi

    matched=0
    for i in "${!keys[@]}"; do
        if (( seen[i] )); then
            printf '  %s: present (%s)\n' "${keys[i]}" "${granted[i]}"
            (( complete[i] )) && matched=1
        else
            printf '  %s: missing\n' "${keys[i]}"
        fi
    done
    (( matched ))
}

# Pre-grant the standalone Zellij plugin's permissions so it never prompts on
# first launch. The grant lives in Zellij's permissions.kdl (a cache file that
# macOS may purge), keyed by the plugin's location; re-running this is safe and
# re-heals after a purge. Other plugins' grants are preserved. WebAccess is
# always granted; the two optional capabilities mirror the plugin's config.
grant_zellij() {
    local plugin_arg="" plugin_path plugins_dir
    local manage_serve=0 cli_fallback=0 force=0 dry_run=0 check=0
    local -a permissions=("WebAccess")

    while (($#)); do
        case "$1" in
            --manage-serve) manage_serve=1 ;;
            --cli-fallback) cli_fallback=1 ;;
            --force) force=1 ;;
            --dry-run) dry_run=1 ;;
            --check) check=1 ;;
            --)
                shift
                (($# <= 1)) || usage_error '--grant-zellij accepts at most one plugin path'
                if (($#)); then
                    plugin_arg="$1"
                fi
                break
                ;;
            -*)
                usage_error "unknown --grant-zellij option: $1"
                ;;
            *)
                [[ -z "${plugin_arg}" ]] || usage_error '--grant-zellij accepts at most one plugin path'
                plugin_arg="$1"
                ;;
        esac
        shift
    done

    (( ! dry_run || ! check )) || usage_error '--dry-run and --check are mutually exclusive'

    if [[ -n "${plugin_arg}" ]]; then
        plugin_path="$(resolve_abs_path "${plugin_arg}")"
    else
        plugins_dir="${ZELLIJ_PLUGINS:-${HOME}/.config/zellij/plugins}"
        plugin_path="$(resolve_abs_path "${plugins_dir}/showy-quota-zellij.wasm")"
    fi

    # The path is written into a KDL string literal ("<key>" { … }); a quote,
    # backslash, or control char would let it break out and inject KDL nodes.
    if [[ "${plugin_path}" == *'"'* || "${plugin_path}" == *\\* || "${plugin_path}" == *[$'\x01'-$'\x1f']* ]]; then
        die "plugin path contains characters unsafe for the KDL permissions file (quote, backslash, or control char): ${plugin_path}"
    fi

    if [[ ! -f "${plugin_path}" ]]; then
        (( force )) || die "plugin file does not exist: ${plugin_path} (pass --force to pre-provision intentionally)"
        printf 'showy-quota: warning: pre-provisioning permissions for absent plugin file: %s\n' "${plugin_path}" >&2
    fi

    (( manage_serve )) && permissions+=("OpenTerminalsOrPlugins")
    (( cli_fallback )) && permissions+=("RunCommands")

    # Zellij 0.44.x keys grants on the bare absolute path; older versions used
    # the `file:` URL form. Write every plausible key so the grant survives
    # version differences and home-relative `file:~` layout entries.
    local -a keys=("${plugin_path}" "file:${plugin_path}")
    [[ "${plugin_path}" == "${HOME}/"* ]] && keys+=("file:~/${plugin_path#"${HOME}/"}")

    local perms_file perms_dir
    perms_file="$(zellij_permissions_file)"
    if (( dry_run || check )); then
        if (( dry_run )); then
            printf 'showy-quota: Zellij permissions dry run (no changes)\n'
        else
            printf 'showy-quota: Zellij permissions check\n'
        fi
        printf '  permissions file: %s\n' "${perms_file}"
        printf '  plugin path:      %s\n' "${plugin_path}"
        if (( dry_run )); then
            printf '  would write keys and permissions:\n'
        else
            printf '  required permissions:\n'
        fi
        printf '   %s\n' "${permissions[@]}"
        if read_zellij_permission_status "${perms_file}" "${keys[@]}" -- "${permissions[@]}"; then
            return 0
        fi
        (( dry_run )) && return 0
        return 1
    fi

    perms_dir="${perms_file%/*}"
    mkdir -p -- "${perms_dir}" || die "cannot create ${perms_dir}"

    with_file_write_lock "${perms_file}" write_zellij_permissions "${perms_file}" "${keys[@]}" -- "${permissions[@]}"

    printf 'showy-quota: pre-granted Zellij plugin permissions\n'
    printf '  permissions file: %s\n' "${perms_file}"
    printf '  plugin path:      %s\n' "${plugin_path}"
    printf '  keys written:     %s\n' "${#keys[@]}"
    printf '  permissions:'
    printf ' %s' "${permissions[@]}"
    printf '\n'
    printf 'Open a new Zellij tab (or restart Zellij) for the grant to take effect.\n'
}

# ── automation: quota guard + prompt segment ───────────────────────────
# guard and prompt consume the same provider metrics every bar renderer uses,
# via showy-quota-state, so they never re-parse CodexBar's JSON schema. Both
# lazily source the shared libs (common.sh sets `set -uo pipefail`, so -e is
# off inside these handlers — every step below checks errors explicitly).

SHOWY_QUOTA_STATE_LIBS_LOADED=0
load_state_libs() {
    (( SHOWY_QUOTA_STATE_LIBS_LOADED )) && return 0
    # shellcheck disable=SC1091
    . "${REPO_ROOT}/lib/common.sh"
    # shellcheck disable=SC1091
    . "${REPO_ROOT}/lib/strip.sh"
    SHOWY_QUOTA_STATE_LIBS_LOADED=1
}

# Resolve showy-quota-fetch the same way the bar drivers do, honoring a custom
# SHOWY_QUOTA_FETCH_BIN or a copied install tree.
automation_fetch_bin() {
    local fetch="${SHOWY_QUOTA_FETCH_BIN:-${SCRIPT_DIR}/showy-quota-fetch}"
    fetch="$(showy_quota_valid_bin "${fetch}")" || fetch="${SCRIPT_DIR}/showy-quota-fetch"
    printf '%s' "${fetch}"
}

# Split a comma-separated provider list into PROVIDER_IDS[]. Rejects ids outside
# CodexBar's id charset so a malformed flag is a usage error, not "unknown".
parse_provider_list() {
    local raw="$1" part
    local -a parts=()
    PROVIDER_IDS=()
    IFS=',' read -r -a parts <<< "${raw}"
    for part in "${parts[@]}"; do
        part="${part#"${part%%[![:space:]]*}"}"
        part="${part%"${part##*[![:space:]]}"}"
        [[ -n "${part}" ]] || continue
        showy_quota_valid_provider_id "${part}" || return 1
        PROVIDER_IDS+=("${part}")
    done
    (( ${#PROVIDER_IDS[@]} > 0 )) || return 1
    return 0
}

# PROVIDER_IDS[] as a compact JSON array (empty array when none selected).
providers_json() {
    (( ${#PROVIDER_IDS[@]} )) || { printf '[]'; return; }
    printf '%s\n' "${PROVIDER_IDS[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))'
}

# jq: reduce state.providerMetrics to the facts guard needs. For each selected
# provider pick a window (explicit slot, or the worst = lowest-remaining slot),
# and partition into unknown / errored / null-window / evaluable.
# shellcheck disable=SC2016  # jq program: $-names are jq variables, not shell
GUARD_JQ='
def slots($m):
  [ {name:"primary",   w:$m.windows.primary},
    {name:"secondary", w:$m.windows.secondary},
    {name:"tertiary",  w:$m.windows.tertiary} ];
def usable($w): ($w != null) and (($w.remainingPercent|type) == "number");
def pick($m):
  if $window == "worst" then
    ( slots($m) | map(select(usable(.w))) )
    | if length == 0 then null else min_by(.w.remainingPercent) end
  else
    ( slots($m) | map(select(.name == $window)) | (.[0] // null) )
    | if (. == null) or (usable(.w) | not) then null else . end
  end;
def entry($pid; $slot):
  { provider: $pid, window: $slot.name,
    usedPercent: $slot.w.usedPercent,
    remainingPercent: $slot.w.remainingPercent,
    minutesUntilReset: $slot.w.minutesUntilReset,
    resetsAt: $slot.w.resetsAt };
(.available) as $available
| (.stale) as $stale
| (.providerMetrics // []) as $pm
| ($pm | map(.provider)) as $present
| (if ($requested|length) > 0 then $requested else $present end) as $targets
| (if ($requested|length) > 0 then ($requested - $present) else [] end) as $unknown
| [ $targets[] as $pid
    | ($pm[] | select(.provider == $pid)) as $m
    | { provider: $pid, error: ($m.error), slot: (pick($m)) }
  ] as $classified
| { available: $available,
    stale: $stale,
    unknown: $unknown,
    errored: [ $classified[] | select(.error != null) | {provider: .provider, kind: (.error.kind), message: (.error.message)} ],
    nullWindow: [ $classified[] | select((.error == null) and (.slot == null)) | .provider ],
    evaluated: [ $classified[] | select((.error == null) and (.slot != null)) | entry(.provider; .slot) ]
  }
| .worst = (if (.evaluated|length) > 0 then (.evaluated | min_by(.remainingPercent)) else null end)
'


guard_help() {
    printf '%s\n' \
        'Usage: showy-quota guard [--provider ID[,ID...]] [--window primary|secondary|tertiary|worst]' \
        '                         [--min-remaining PCT | --max-used PCT] [--no-fetch] [--allow-stale]' \
        '                         [--wait-max SECONDS (0-999999999)] [--json] [--quiet]' \
        '' \
        'Runs a refresh-window fetch by default; --no-fetch evaluates the cache as-is.' \
        'Window default "worst" = the non-null slot with the least remaining per provider.' \
        'Default threshold: --min-remaining 10. The boundary is inclusive-pass:' \
        '  --min-remaining N passes when remaining >= N (breach when remaining < N);' \
        '  --max-used N       passes when used <= N      (breach when used > N).' \
        'Exit codes: 0 pass, 1 breach, 2 unusable data, 3 usage error.'
}

guard_usage_error() {
    printf 'showy-quota %s: %s\n\n' "${G_COMMAND:-guard}" "$1" >&2
    if [[ "${G_COMMAND:-guard}" == run ]]; then
        printf 'Usage: showy-quota run [guard options] -- <command...>\n' >&2
        exit 2
    fi
    guard_help >&2
    exit 3
}

guard_valid_pct() { [[ "$1" =~ ^[0-9]{1,3}$ ]] && (( 10#$1 <= 100 )); }
# Nine digits keep wait budgets within Bash integer range before 10# conversion.
guard_valid_uint() { [[ "$1" =~ ^[0-9]{1,9}$ ]]; }

# Evaluate once against showy-quota-state --json. Reads globals G_WIN, G_TK,
# G_TV, G_AS, G_NF, REQUESTED_JSON, PROVIDER_IDS, STATE_BIN; sets G_EXIT, G_REASON,
# G_STALE, G_EVALUATED, G_WORST_JSON, G_BREACH.
guard_evaluate() {
    G_BREACH=0
    local state_json facts
    local -a state_args=(--json)
    (( G_NF )) && state_args+=(--no-fetch)
    state_json="$("${STATE_BIN}" "${state_args[@]}" 2>/dev/null)" || state_json=""
    if [[ -z "${state_json}" ]] || ! printf '%s' "${state_json}" | jq -e 'type == "object"' >/dev/null 2>&1; then
        G_EXIT=2; G_REASON="no-cache"; G_STALE=false; G_EVALUATED=0; G_WORST_JSON=null; return
    fi
    if ! facts="$(printf '%s' "${state_json}" | jq -c --argjson requested "${REQUESTED_JSON}" --arg window "${G_WIN}" "${GUARD_JQ}")"; then
        G_EXIT=2; G_REASON="state-error"; G_STALE=false; G_EVALUATED=0; G_WORST_JSON=null; return
    fi

    # One jq pass extracts every scalar the decision needs (one line each, so
    # empty joins survive as empty elements); worst stays a JSON object.
    local -a F=()
    mapfile -t F < <(printf '%s' "${facts}" | jq -r '
        [ (.available | tostring),
          (.stale | tostring),
          (.unknown | length | tostring),
          (.errored | length | tostring),
          (.nullWindow | length | tostring),
          (.evaluated | length | tostring),
          (.unknown | join(",")),
          ([.errored[] | "\(.provider)(\(.kind // "unknown"))"] | join(",")),
          (.nullWindow | join(",")),
          (((.worst.remainingPercent) // "null") | tostring),
          (((.worst.usedPercent) // "null") | tostring)
        ] | .[]')
    G_WORST_JSON="$(printf '%s' "${facts}" | jq -c '.worst')"

    local available="${F[0]}" errored_join="${F[7]}"
    G_STALE="${F[1]}"
    local unknown_n="${F[2]}" errored_n="${F[3]}" nullw_n="${F[4]}"
    G_EVALUATED="${F[5]}"
    local unknown_join="${F[6]}" nullw_join="${F[8]}"
    local wr="${F[9]}" wu="${F[10]}"

    if [[ "${available}" != "true" ]]; then
        G_EXIT=2; G_REASON="no-cache"; return
    fi
    if (( ${#PROVIDER_IDS[@]} > 0 )); then
        if (( unknown_n > 0 )); then
            G_EXIT=2; G_REASON="unknown-provider: ${unknown_join}"; return
        fi
        if (( errored_n > 0 )); then
            G_EXIT=2; G_REASON="provider-error: ${errored_join}"; return
        fi
        if (( nullw_n > 0 )); then
            G_EXIT=2; G_REASON="null-window: ${nullw_join}/${G_WIN}"; return
        fi
    fi
    if (( G_EVALUATED == 0 )); then
        if (( errored_n > 0 )); then
            G_EXIT=2; G_REASON="provider-error: ${errored_join}"; return
        fi
        G_EXIT=2; G_REASON="no-usable-data"; return
    fi
    if [[ "${G_STALE}" == "true" && "${G_AS}" != "1" ]]; then
        G_EXIT=2; G_REASON="stale"; return
    fi

    if [[ "${G_TK}" == "max-used" ]]; then
        (( wu > G_TV )) && G_BREACH=1
    else
        (( wr < G_TV )) && G_BREACH=1
    fi
    if (( G_BREACH )); then G_EXIT=1; G_REASON="breach"; else G_EXIT=0; G_REASON="pass"; fi
}

guard_emit_json() {
    jq -cn \
        --argjson exitc "${G_EXIT}" \
        --arg reason "${G_REASON}" \
        --argjson stale "${G_STALE}" \
        --argjson evaluated "${G_EVALUATED}" \
        --argjson worst "${G_WORST_JSON}" \
        '{exit: $exitc, ok: ($exitc == 0), reason: $reason, stale: $stale, evaluated: $evaluated, worst: $worst}'
}

guard_emit_human() {
    local clause
    if [[ "${G_TK}" == "max-used" ]]; then clause="max-used ${G_TV}%"; else clause="min-remaining ${G_TV}%"; fi
    if (( G_EXIT == 2 )); then
        printf 'showy-quota guard: unusable — %s\n' "${G_REASON}"
        return
    fi
    if [[ "${G_WORST_JSON}" == "null" ]]; then
        printf 'showy-quota guard: ok\n'
        return
    fi
    local -a W=()
    mapfile -t W < <(printf '%s' "${G_WORST_JSON}" | jq -r '[.provider, .window, (.remainingPercent|tostring), (.usedPercent|tostring)] | .[]')
    local p="${W[0]}" w="${W[1]}" r="${W[2]}" u="${W[3]}"
    if (( G_EXIT == 1 )); then
        if [[ "${G_TK}" == "max-used" ]]; then
            printf 'showy-quota guard: BREACH — %s/%s %s%% used > %s%% (%s)\n' "${p}" "${w}" "${u}" "${G_TV}" "${clause}"
        else
            printf 'showy-quota guard: BREACH — %s/%s %s%% remaining < %s%% (%s)\n' "${p}" "${w}" "${r}" "${G_TV}" "${clause}"
        fi
    else
        if [[ "${G_TK}" == "max-used" ]]; then
            printf 'showy-quota guard: ok — %s/%s %s%% used <= %s%% (%s)\n' "${p}" "${w}" "${u}" "${G_TV}" "${clause}"
        else
            printf 'showy-quota guard: ok — %s/%s %s%% remaining >= %s%% (%s)\n' "${p}" "${w}" "${r}" "${G_TV}" "${clause}"
        fi
    fi
}

cmd_guard() {
    cmd_guard_or_run guard "$@"
}

cmd_run() {
    cmd_guard_or_run run "$@"
}

cmd_guard_or_run() {
    local mode="$1"
    G_COMMAND="${mode}"
    shift
    load_state_libs
    showy_quota_have jq || { printf 'showy-quota %s: jq is required\n' "${mode}" >&2; if [[ "${mode}" == guard ]]; then exit 3; else exit 2; fi; }

    PROVIDER_IDS=()
    local window="worst" threshold_kind="" threshold_value=""
    local no_fetch=0 allow_stale=0 wait_max=0 json_mode=0 quiet=0
    local -a command=()
    while (($#)); do
        case "$1" in
            --)
                [[ "${mode}" == run ]] || guard_usage_error "unknown argument: $1"
                shift
                (($#)) || { printf 'showy-quota run: command required after --\n' >&2; exit 2; }
                command=("$@")
                break ;;
            --provider)
                (($# >= 2)) || guard_usage_error '--provider requires a value'
                parse_provider_list "$2" || guard_usage_error "invalid --provider value: $2"
                shift 2 ;;
            --window)
                (($# >= 2)) || guard_usage_error '--window requires a value'
                case "$2" in
                    primary|secondary|tertiary|worst) window="$2" ;;
                    *) guard_usage_error "invalid --window (primary|secondary|tertiary|worst): $2" ;;
                esac
                shift 2 ;;
            --min-remaining)
                (($# >= 2)) || guard_usage_error '--min-remaining requires a value'
                [[ -z "${threshold_kind}" ]] || guard_usage_error '--min-remaining and --max-used are mutually exclusive'
                guard_valid_pct "$2" || guard_usage_error "invalid --min-remaining (0-100): $2"
                threshold_kind="min-remaining"; threshold_value=$((10#$2))
                shift 2 ;;
            --max-used)
                (($# >= 2)) || guard_usage_error '--max-used requires a value'
                [[ -z "${threshold_kind}" ]] || guard_usage_error '--min-remaining and --max-used are mutually exclusive'
                guard_valid_pct "$2" || guard_usage_error "invalid --max-used (0-100): $2"
                threshold_kind="max-used"; threshold_value=$((10#$2))
                shift 2 ;;
            --allow-stale) allow_stale=1; shift ;;
            --no-fetch) no_fetch=1; shift ;;
            --wait-max)
                (($# >= 2)) || guard_usage_error '--wait-max requires a value'
                guard_valid_uint "$2" || guard_usage_error "invalid --wait-max (seconds): $2"
                wait_max=$((10#$2)); shift 2 ;;
            --json)  json_mode=1; shift ;;
            --quiet) quiet=1; shift ;;
            -h|--help)
                if [[ "${mode}" == run ]]; then
                    printf '%s\n' 'Usage: showy-quota run [guard options] -- <command...>' \
                        'Uses guard thresholds and exit codes; passes the child exit code on success.' \
                        'On breach, --wait-max waits for known resets and retries while the budget remains.'
                else
                    guard_help
                fi
                return 0 ;;
            *) if [[ "${mode}" == run ]]; then
                   printf 'showy-quota run: unknown argument: %s\n' "$1" >&2; exit 2
               else guard_usage_error "unknown argument: $1"; fi ;;
        esac
    done
    if [[ "${mode}" == run && ${#command[@]} -eq 0 ]]; then
        printf 'showy-quota run: command required after --\n' >&2
        exit 2
    fi

    if [[ -z "${threshold_kind}" ]]; then
        threshold_kind="min-remaining"; threshold_value=10
    fi

    STATE_BIN="${SCRIPT_DIR}/showy-quota-state"
    local fetch=""
    REQUESTED_JSON="$(providers_json)"
    G_WIN="${window}"; G_TK="${threshold_kind}"; G_TV="${threshold_value}"; G_AS="${allow_stale}"; G_NF="${no_fetch}"

    # Guard fetches by default (automation wants current data). --no-fetch skips
    # every fetch, so a hook pays only the cache-only state read: the fetch
    # binary is not even resolved.
    if (( ! no_fetch )); then
        fetch="$(automation_fetch_bin)"
        "${fetch}" >/dev/null 2>&1 || true
    fi
    guard_evaluate

    # Guard keeps its historical single retry. Run can cross multiple distinct
    # reset windows, but never polls: each retry follows one reset-length sleep.
    local attempts=0 start_epoch remaining_budget wmin wsecs sleep_secs reset_key=""
    start_epoch=$(date +%s)
    while (( G_BREACH && wait_max > 0 )); do
        if [[ "${mode}" == guard ]] && (( attempts > 0 )); then break; fi
        remaining_budget=$((wait_max - ($(date +%s) - start_epoch)))
        (( remaining_budget > 0 )) || break
        local -a reset_fields=()
        mapfile -t reset_fields < <(printf '%s' "${G_WORST_JSON}" | jq -r '[.provider, .window, (.resetsAt // ""), (.minutesUntilReset // "null" | tostring)] | .[]')
        wmin="${reset_fields[3]}"
        [[ "${wmin}" =~ ^[0-9]+$ ]] || break
        wsecs=$((wmin * 60))
        (( wsecs <= remaining_budget )) || break
        # An unchanged cache must not cause repeated sleeps at the same reset.
        local next_key="${reset_fields[0]}/${reset_fields[1]}/${reset_fields[2]}"
        [[ "${next_key}" != "${reset_key}" ]] || break
        reset_key="${next_key}"
        sleep_secs=$((wsecs + 30))
        (( sleep_secs > remaining_budget )) && sleep_secs=${remaining_budget}
        (( sleep_secs > 0 )) || break
        sleep "${sleep_secs}"
        if (( ! no_fetch )); then
            "${fetch}" --refresh >/dev/null 2>&1 || true
        fi
        guard_evaluate
        attempts=$((attempts + 1))
    done

    if [[ "${mode}" == run && "${G_EXIT}" == 0 ]]; then
        exec "${command[@]}"
    fi

    if (( json_mode )); then
        guard_emit_json
    elif (( quiet )); then
        (( G_EXIT != 0 )) && guard_emit_human
    else
        guard_emit_human
    fi
    exit "${G_EXIT}"
}

prompt_usage_error() {
    printf 'showy-quota prompt: %s\n' "$1" >&2
    printf 'Usage: showy-quota prompt [--ansi] [--provider ID] [--format SPEC]\n' >&2
    exit 2
}

cmd_prompt() {
    load_state_libs
    # A prompt segment must never break a shell: any environment failure prints
    # the neutral "AI ?" and exits 0. Only argument errors exit non-zero.

    PROVIDER_IDS=()
    local ansi=0 prompt_format
    while (($#)); do
        case "$1" in
            --ansi) ansi=1; shift ;;
            --format)
                (($# >= 2)) || prompt_usage_error '--format requires a template'
                prompt_format="$2"; shift 2 ;;
            --provider)
                (($# >= 2)) || prompt_usage_error '--provider requires a value'
                parse_provider_list "$2" || prompt_usage_error "invalid --provider value: $2"
                shift 2 ;;
            -h|--help)
                printf '%s\n' \
                    'Usage: showy-quota prompt [--ansi] [--provider ID] [--format SPEC]' \
                    '' \
                    'Prints "<SIGIL> <used>% <countdown>" for the worst-remaining provider window.' \
                    '--format SPEC expands {provider}, {sigil}, {used}, {remaining}, {countdown}, {class}, {window}, and {stale}.' \
                    'Use {{ and }} for literal braces. Invalid fields exit 2.' \
                    'Reads the cache as-is; set SHOWY_QUOTA_PROMPT_FETCH=1 to refresh first.' \
                    '--ansi adds severity color (suppressed by NO_COLOR). Always exits 0 (usage errors aside).'
                return 0 ;;
            *) prompt_usage_error "unknown argument: $1" ;;
        esac
    done

    showy_quota_export_config

    local render_bin
    if ! render_bin="$(showy_quota_resolve_render_bin "${SCRIPT_DIR}" "${SCRIPT_DIR}/..")"; then
        printf 'AI ?\n'
        exit 0
    fi

    if showy_quota_bool "${SHOWY_QUOTA_PROMPT_FETCH-}" 0; then
        local fetch; fetch="$(automation_fetch_bin)"
        "${fetch}" --refresh >/dev/null 2>&1 || true
    fi

    local -a provider_args=()
    if (( ${#PROVIDER_IDS[@]} > 0 )); then
        local provider_csv
        provider_csv="$(IFS=,; printf '%s' "${PROVIDER_IDS[*]}")"
        provider_args=(--provider "${provider_csv}")
    fi

    local -a render_args=(--emit prompt --from-cache)
    if [[ ${prompt_format+x} ]]; then render_args+=(--format "${prompt_format}"); fi
    (( ansi )) && render_args+=(--ansi)
    render_args+=("${provider_args[@]}")

    local render_rc=0
    if [[ ${prompt_format+x} ]]; then
        "${render_bin}" "${render_args[@]}" || render_rc=$?
    else
        "${render_bin}" "${render_args[@]}" 2>/dev/null || render_rc=$?
    fi
    if (( render_rc == 2 )); then exit 2; fi
    if (( render_rc != 0 )); then printf 'AI ?\n'; fi
    exit 0
}

automation_usage_error() {
    local verb="$1" message="$2"
    printf 'showy-quota %s: %s\n' "${verb}" "${message}" >&2
    exit 2
}

cmd_next_reset() {
    load_state_libs
    showy_quota_have jq || automation_usage_error next-reset 'jq is required'
    PROVIDER_IDS=()
    local window=worst no_fetch=0 json_mode=0 epoch_mode=0 mode_seen=0
    while (($#)); do
        case "$1" in
            --provider)
                (($# >= 2)) || automation_usage_error next-reset '--provider requires ID'
                parse_provider_list "$2" || automation_usage_error next-reset 'invalid provider ID'
                ((${#PROVIDER_IDS[@]} == 1)) || automation_usage_error next-reset '--provider requires one ID'
                shift 2 ;;
            --window)
                (($# >= 2)) || automation_usage_error next-reset '--window requires a value'
                case "$2" in primary|secondary|tertiary|worst) window="$2" ;;
                    *) automation_usage_error next-reset 'invalid window' ;; esac
                shift 2 ;;
            --json) json_mode=1; shift ;;
            --epoch|--seconds)
                (( ! mode_seen )) || automation_usage_error next-reset '--epoch and --seconds are mutually exclusive'
                mode_seen=1
                [[ "$1" == --epoch ]] && epoch_mode=1
                shift ;;
            --no-fetch) no_fetch=1; shift ;;
            -h|--help)
                printf '%s\n' 'Usage: showy-quota next-reset [--provider ID] [--window primary|secondary|tertiary|worst] [--json] [--epoch|--seconds] [--no-fetch]' \
                    'Prints seconds until reset by default; --epoch prints a Unix timestamp. Exit 1 when unknown.'
                return 0 ;;
            *) automation_usage_error next-reset "unknown argument: $1" ;;
        esac
    done
    if (( ! no_fetch )); then
        local fetch; fetch="$(automation_fetch_bin)"
        "${fetch}" >/dev/null 2>&1 || true
    fi
    local -a state_args=(--json --no-fetch)
    local state facts now
    state="$("${SCRIPT_DIR}/showy-quota-state" "${state_args[@]}" 2>/dev/null)" || return 1
    now="$(showy_quota_now_epoch)"
    facts="$(printf '%s' "${state}" | jq -c --argjson requested "$(providers_json)" --arg window "${window}" "${GUARD_JQ}" 2>/dev/null)" || return 1
    # The metric clock is authoritative for relative time; ISO reset timestamps
    # retain sub-minute precision when present. Descriptions use metric minutes.
    local selected
    selected="$(printf '%s' "${facts}" | jq -c --argjson now "${now}" '
        def exact_epoch:
          if type != "string" then null
          else (try capture("^(?<utc>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?:[.][0-9]+)?(?<zone>Z|[+-][0-9]{2}:?[0-9]{2})$") catch null) as $d
            | if $d == null then null
              else try (
                ($d.utc | strptime("%Y-%m-%dT%H:%M:%S") | mktime)
                - (if $d.zone == "Z" then 0
                   else (($d.zone[1:3] | tonumber) * 3600 + ($d.zone[-2:] | tonumber) * 60)
                        * (if $d.zone[0:1] == "+" then 1 else -1 end)
                   end)
              ) catch null end
          end;
        .worst
        | select(. != null and .minutesUntilReset != null)
        | . as $w
        | (.resetsAt | exact_epoch) as $exact
        | ($exact // ($now + $w.minutesUntilReset * 60)) as $epoch
        | $w + {resetEpoch: $epoch, secondsUntilReset: ([$epoch - $now, 0] | max)}
    ' 2>/dev/null)" || return 1
    [[ -n "${selected}" ]] || return 1
    if (( json_mode )); then
        printf '%s\n' "${selected}"
    elif (( epoch_mode )); then
        printf '%s\n' "${selected}" | jq -r '.resetEpoch'
    else
        printf '%s\n' "${selected}" | jq -r '.secondsUntilReset'
    fi
}

cmd_pick() {
    load_state_libs
    PROVIDER_IDS=()
    local floor=0 window=worst format=id no_fetch=0
    while (($#)); do
        case "$1" in
            --providers)
                (($# >= 2)) || automation_usage_error pick '--providers requires IDs'
                parse_provider_list "$2" || automation_usage_error pick 'invalid provider list'
                shift 2 ;;
            --window)
                (($# >= 2)) || automation_usage_error pick '--window requires a value'
                case "$2" in primary|secondary|tertiary|worst) window="$2" ;;
                    *) automation_usage_error pick 'invalid window' ;; esac
                shift 2 ;;
            --min-remaining)
                (($# >= 2)) || automation_usage_error pick '--min-remaining requires a value'
                guard_valid_pct "$2" || automation_usage_error pick 'invalid floor (0-100)'
                floor=$((10#$2)); shift 2 ;;
            --format)
                (($# >= 2)) || automation_usage_error pick '--format requires id or json'
                case "$2" in id|json) format="$2" ;;
                    *) automation_usage_error pick 'invalid format' ;; esac
                shift 2 ;;
            --no-fetch) no_fetch=1; shift ;;
            -h|--help)
                printf '%s\n' 'Usage: showy-quota pick [--min-remaining N] [--window primary|secondary|tertiary|worst] [--format id|json] [--no-fetch] [--providers a,b]' \
                    'Selects the provider with the most remaining quota; exit 1 when none qualifies.'
                return 0 ;;
            *) automation_usage_error pick "unknown argument: $1" ;;
        esac
    done
    showy_quota_export_config
    local render_bin
    render_bin="$(showy_quota_resolve_render_bin "${SCRIPT_DIR}" "${SCRIPT_DIR}/..")" || return 1
    if (( ! no_fetch )); then
        local fetch; fetch="$(automation_fetch_bin)"
        "${fetch}" >/dev/null 2>&1 || true
    fi
    local -a args=(--emit pick --from-cache --window "${window}" --min-remaining "${floor}" --pick-format "${format}")
    if ((${#PROVIDER_IDS[@]})); then
        args+=(--provider "$(IFS=,; printf '%s' "${PROVIDER_IDS[*]}")")
    fi
    "${render_bin}" "${args[@]}" 2>/dev/null
}

cmd_refresh() {
    if (($#)); then
        case "$1" in -h|--help)
            (($# == 1)) || automation_usage_error refresh 'unexpected argument'
            printf 'Usage: showy-quota refresh\nForce a fetch, then nudge present host surfaces.\n'
            return 0 ;;
        *) automation_usage_error refresh "unknown argument: $1" ;; esac
    fi
    load_state_libs
    local fetch; fetch="$(automation_fetch_bin)"
    "${fetch}" --refresh || return $?
    if showy_quota_have sketchybar; then
        sketchybar --trigger showy_quota_refresh >/dev/null 2>&1 || true
    fi
    local client status_right status_left
    if showy_quota_have tmux && tmux has-session 2>/dev/null; then
        status_right="$(tmux show-options -gqv status-right 2>/dev/null || true)"
        status_left="$(tmux show-options -gqv status-left 2>/dev/null || true)"
        if [[ "${status_right}" == *showy-quota-tmux-bar* || "${status_left}" == *showy-quota-tmux-bar* ]]; then
            while IFS= read -r client; do
                [[ -n "${client}" ]] && tmux refresh-client -S -t "${client}" >/dev/null 2>&1 || true
            done < <(tmux list-clients -F '#{client_tty}' 2>/dev/null)
        fi
    fi
    # The advanced zjstatus feeder has a pipe; the standalone WASM plugin does
    # not. Only address a named live session, never create one while refreshing.
    if [[ -n "${ZELLIJ_SESSION_NAME:-}" ]] && showy_quota_have "${SHOWY_QUOTA_ZELLIJ_BIN}"; then
        local render_bin payload session found=0
        while IFS= read -r session; do
            [[ "${session}" == "${ZELLIJ_SESSION_NAME}" ]] && found=1
        done < <("${SHOWY_QUOTA_ZELLIJ_BIN}" list-sessions --short --no-formatting 2>/dev/null)
        if (( found )) && render_bin="$(showy_quota_resolve_render_bin "${SCRIPT_DIR}" "${SCRIPT_DIR}/..")" \
            && payload="$("${render_bin}" --from-cache 2>/dev/null)" && [[ -n "${payload}" ]]; then
            "${SHOWY_QUOTA_ZELLIJ_BIN}" --session "${ZELLIJ_SESSION_NAME}" pipe \
                --name "${SHOWY_QUOTA_ZELLIJ_PIPE_NAME}" -- \
                "zjstatus::pipe::${SHOWY_QUOTA_ZELLIJ_WIDGET}::${payload}" >/dev/null 2>&1 || true
        fi
    fi
}

cmd_serve() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        (($# == 1)) || usage_error 'serve help does not accept arguments'
        printf '%s\n' \
            'Usage: showy-quota serve status [--json]' \
            '       showy-quota serve restart|stop' \
            '' \
            'Status only probes /health and reads cache state. Restart requires managed serve and a local URL.'
        return 0
    fi
    local action="${1:-}" fetch="${SCRIPT_DIR}/showy-quota-fetch"
    (($# > 0)) && shift
    case "${action}" in
        status)
            if (($# == 0)); then
                exec "${fetch}" --serve-status
            elif (($# == 1)) && [[ "$1" == "--json" ]]; then
                exec "${fetch}" --serve-status --json
            fi
            ;;
        restart|stop)
            if (($# == 0)); then
                exec "${fetch}" "--${action}-serve"
            fi
            ;;
    esac
    printf 'showy-quota serve: expected status [--json], restart, or stop\n' >&2
    exit 2
}

main() {
    if (($# == 0)); then
        run_selector
        return 0
    fi

    case "$1" in
        --set)
            (($# == 2)) || usage_error '--set requires exactly one theme name'
            set_theme "$2"
            ;;
        --unset)
            (($# == 1)) || usage_error '--unset does not accept arguments'
            unset_theme
            ;;
        --current)
            (($# == 1)) || usage_error '--current does not accept arguments'
            print_current_theme
            ;;
        --list)
            (($# == 1)) || usage_error '--list does not accept arguments'
            list_theme_names
            ;;
        --preview)
            (($# == 2)) || usage_error '--preview requires exactly one theme name'
            preview_theme "$2"
            ;;
        --check-config)
            check_config "$@"
            ;;
        --diagnose)
            local diagnose_as_json=0
            shift
            while (($#)); do
                case "$1" in
                    --json)   diagnose_as_json=1 ;;
                    --redact) DIAGNOSE_REDACT=1 ;;
                    *) usage_error '--diagnose only accepts --json and --redact' ;;
                esac
                shift
            done
            if (( diagnose_as_json )); then
                diagnose_json
            else
                diagnose
            fi
            ;;
        --grant-zellij)
            shift
            grant_zellij "$@"
            ;;
        guard)
            shift
            cmd_guard "$@"
            ;;
        prompt)
            shift
            cmd_prompt "$@"
            ;;
        next-reset)
            shift
            cmd_next_reset "$@"
            ;;
        run)
            shift
            cmd_run "$@"
            ;;
        pick)
            shift
            cmd_pick "$@"
            ;;
        refresh)
            shift
            cmd_refresh "$@"
            ;;
        serve)
            shift
            cmd_serve "$@"
            ;;
        -h|--help)
            (($# == 1)) || usage_error '--help does not accept arguments'
            usage
            ;;
        *)
            usage_error "unknown argument: $1"
            ;;
    esac
}

main "$@"
