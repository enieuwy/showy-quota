#!/usr/bin/env bash
# showy-quota — shared CodexBar JSON fetcher.
#
# Thin compatibility shim over the native showy-quota-fetch-native binary.
# Configuration still loads through lib/common.sh, so shell-managed env knobs
# keep one owner there; this wrapper forwards every argument unchanged.
#
# Exit 0 whenever any cache content was emitted (fresh or stale).
# Exit 1 only when no cache exists and the first fetch fails.
#
# Flags:
#   --refresh   Force a refresh regardless of cache age.
#   --json      Default. Print the cached JSON.
#   --cache-only Print existing valid cache without refreshing.
#   --age       Print cache age in seconds and exit.
#   --path      Print the cache file path and exit.
#   --stop-serve Stop the managed codexbar serve process and exit.
#   --serve-status [--json] Report managed serve and cache state without changing it.
#   --restart-serve Stop and restart the managed serve under the refresh lock.
#   --record NAME --fixture-dir DIR [--sanitize] Capture one live payload into DIR/NAME.json.
#   --replay FILE|- Print a validated fixture payload as canonical JSON.
# This script is intentionally narrow: every renderer reads from the same
# cache file so we never fan out N parallel `codexbar` invocations.
set -euo pipefail
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "${SCRIPT_PATH}" ]]; do
    link=$(readlink "${SCRIPT_PATH}")
    if [[ "${link}" == /* ]]; then
        SCRIPT_PATH="${link}"
    else
        SCRIPT_PATH="$(cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd -P)/${link}"
    fi
done
SCRIPT_DIR="$(cd -- "$(dirname -- "${SCRIPT_PATH}")" && pwd -P)"
# shellcheck disable=SC1091
. "${SCRIPT_DIR}/../lib/common.sh"
native_bin=""
for candidate in "${SCRIPT_DIR}/../target/release/showy-quota-fetch-native" "${SCRIPT_DIR}/showy-quota-fetch-native"; do
    if [[ -x "${candidate}" ]]; then
        native_bin="${candidate}"
        break
    fi
done
if [[ -z "${native_bin}" ]] && command -v showy-quota-fetch-native >/dev/null 2>&1; then
    native_bin="$(command -v showy-quota-fetch-native)"
fi
if [[ -z "${native_bin}" ]]; then
    printf 'showy-quota-fetch: native showy-quota-fetch-native not installed; run make render-bin\n' >&2
    exit 1
fi
showy_quota_export_config
exec "${native_bin}" "$@"
